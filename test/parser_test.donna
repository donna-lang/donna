// ── Expression parsing: arithmetic ───────────────────────────────────────────

pub fn parse_addition_test() -> String:
  case parse_src("fn f(x: Int) -> Int:\n  x + 1"):
    parse_result.PErr(_) -> should.fail("parse failed")
    parse_result.POk(m, _) ->
      case module_fns(m):
        [ast.Function(_, _, _, _, ast.Block([ast.ExprStmt(ast.BinOp(ast.BAdd, _, _, _), _)], _), _)] -> ""
        _ -> should.fail("expected BinOp(BAdd)")

