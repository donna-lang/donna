    parse_result.POk(m, _) ->
      case module_consts(m):
        [ast.Const(_, _, option.Some(ast.TyTuple([ast.TyName("Int", [], _), ast.TyName("String", [], _)], _)), _, _)] -> ""
        _ -> should.fail("expected TyTuple([Int, String])")

pub fn parse_type_fn_annotation_test() -> String:
  case parse_src("const f: fn(Int) -> Bool = fn(x: Int) -> x == 0"):
    parse_result.PErr(_) -> should.fail("parse failed")
    parse_result.POk(m, _) ->
      case module_consts(m):
        [ast.Const(_, _, option.Some(ast.TyFn([ast.TyName("Int", [], _)], ast.TyName("Bool", [], _), _)), _, _)] -> ""
        _ -> should.fail("expected TyFn([Int], Bool)")

pub fn parse_type_qualified_test() -> String:
  case parse_src("const x: option.Option(Int) = option.None"):
    parse_result.PErr(_) -> should.fail("parse failed")
    parse_result.POk(m, _) ->
      case module_consts(m):
        [ast.Const(_, _, option.Some(ast.TyName("option.Option", [ast.TyName("Int", [], _)], _)), _, _)] -> ""
        _ -> should.fail("expected TyName(option.Option, [Int])")

pub fn parse_type_multiline_args_test() -> String:
  case parse_src("const x: Result(\n  Int,\n  String\n) = 0"):
    parse_result.PErr(_) -> should.fail("parse failed — multiline type args should work")
    parse_result.POk(_, _) -> ""

// ── Error cases ───────────────────────────────────────────────────────────────

pub fn parse_err_missing_colon_in_fn_test() -> String:
  case parse_src("fn foo(x: Int) -> Int\n  x"):
    parse_result.PErr(_) -> ""
    parse_result.POk(_, _) -> should.fail("should fail: no `:` after fn signature")

pub fn parse_err_missing_arrow_in_lambda_test() -> String:
  case parse_src("const f = fn(x: Int) x"):
    parse_result.PErr(_) -> ""
    parse_result.POk(_, _) -> should.fail("should fail: no `->` in lambda")

pub fn parse_err_unexpected_token_in_expr_test() -> String:
  case parse_src("const x = :"):
    parse_result.PErr(_) -> ""
    parse_result.POk(_, _) -> should.fail("`:` is not a valid expression start")

pub fn parse_err_unclosed_paren_test() -> String:
  case parse_src("const x = (1 + 2"):
    parse_result.PErr(_) -> ""
    parse_result.POk(_, _) -> should.fail("unclosed paren should fail")

pub fn parse_err_unclosed_list_test() -> String:
  case parse_src("const xs = [1, 2"):
    parse_result.PErr(_) -> ""
    parse_result.POk(_, _) -> should.fail("unclosed list should fail")

pub fn parse_err_external_wrong_syntax_test() -> String:
  case parse_src("@external(not_a_string)\nfn foo() -> Int"):
    parse_result.PErr(_) -> ""
    parse_result.POk(_, _) -> should.fail("malformed @external should fail")

pub fn parse_err_unexpected_top_level_token_test() -> String:
  case parse_src("123"):
    parse_result.PErr(_) -> ""
    parse_result.POk(_, _) -> should.fail("bare integer at top level should fail")

// ── Mixed declarations ────────────────────────────────────────────────────────

pub fn parse_mixed_declarations_test() -> String:
  let src = string.join([
    "import donna/string",
    "pub const greeting = \"hello\"",
    "pub type Color:",
    "  Red",
    "  Green",
    "pub fn main() -> Int:",
    "  42"
  ], "\n")
  case parse_src(src):
    parse_result.PErr(_) -> should.fail("parse failed")
    parse_result.POk(m, _) ->
      let ok = list.length(module_imports(m)) == 1 && list.length(module_consts(m)) == 1 && list.length(module_type_defs(m)) == 1 && list.length(module_fns(m)) == 1
      case ok:
        True -> ""
        False -> should.fail("expected 1 import, 1 const, 1 type, 1 fn")

pub fn parse_multiple_functions_test() -> String:
  let src = string.join([
    "fn double(x: Int) -> Int:",
    "  x * 2",
    "fn triple(x: Int) -> Int:",
    "  x * 3"
  ], "\n")
  case parse_src(src):
    parse_result.PErr(_) -> should.fail("parse failed")
    parse_result.POk(m, _) ->
      case list.length(module_fns(m)):
        2 -> ""
        n -> should.fail("expected 2 functions, got " <> int.to_string(n))

pub fn parse_multi_stmt_block_test() -> String:
  case parse_src("fn f() -> Int:\n  let x = 1\n  let y = 2\n  x + y"):
    parse_result.PErr(_) -> should.fail("parse failed")
    parse_result.POk(m, _) ->
      case module_fns(m):
        [ast.Function(_, _, _, _, ast.Block(stmts, _), _)] ->
          case list.length(stmts):
            3 -> ""
            n -> should.fail("expected 3 stmts, got " <> int.to_string(n))
        _ -> should.fail("expected block with 3 stmts")

pub fn parse_nested_case_test() -> String:
  let src = string.join([
    "fn f(x: Bool, y: Bool) -> Int:",
    "  case x:",
    "    True ->",
    "      case y:",
    "        True -> 1",
    "        False -> 0",
    "    False -> -1"
  ], "\n")
  case parse_src(src):
    parse_result.PErr(_) -> should.fail("nested case should parse ok")
    parse_result.POk(_, _) -> ""

pub fn parse_err_missing_colon_fn_test() -> String:
  case parse_src("fn foo() -> Int\n  42"):
    parse_result.POk(_, _) -> should.fail("should have failed")
    parse_result.PErr(e) ->
      case e:
        error.ParseMissingColon(_) -> ""
        _ -> should.fail("expected ParseMissingColon")

pub fn parse_err_missing_colon_type_test() -> String:
  case parse_src("type Color\n  Red\n  Blue"):
    parse_result.POk(_, _) -> should.fail("should have failed")
    parse_result.PErr(e) ->
      case e:
        error.ParseMissingColon(_) -> ""
        _ -> should.fail("expected ParseMissingColon")

pub fn parse_err_missing_colon_case_test() -> String:
  case parse_src("fn f(x: Int) -> Int:\n  case x\n    1 -> 1"):
    parse_result.POk(_, _) -> should.fail("should have failed")
    parse_result.PErr(e) ->
      case e:
        error.ParseMissingColon(_) -> ""
        _ -> should.fail("expected ParseMissingColon")

pub fn parse_err_missing_arrow_case_arm_test() -> String:
  case parse_src("fn f(x: Int) -> Int:\n  case x:\n    1 99"):
    parse_result.POk(_, _) -> should.fail("should have failed")
    parse_result.PErr(e) ->
      case e:
        error.ParseMissingArrow(_) -> ""
        _ -> should.fail("expected ParseMissingArrow")

pub fn parse_err_missing_arrow_lambda_test() -> String:
  case parse_src("fn f() -> Int:\n  let g = fn(x: Int) x + 1\n  g(2)"):
    parse_result.POk(_, _) -> should.fail("should have failed")
    parse_result.PErr(e) ->
      case e:
        error.ParseMissingArrow(_) -> ""
        _ -> should.fail("expected ParseMissingArrow")

pub fn parse_err_uppercase_fn_name_test() -> String:
  case parse_src("fn Foo() -> Int:\n  1"):
    parse_result.POk(_, _) -> should.fail("should have failed")
    parse_result.PErr(e) ->
      case e:
        error.ParseUppercaseFnName("Foo", _) -> ""
        _ -> should.fail("expected ParseUppercaseFnName(\"Foo\")")

pub fn parse_err_lowercase_type_name_test() -> String:
  case parse_src("type color:\n  Red\n  Blue"):
    parse_result.POk(_, _) -> should.fail("should have failed")
    parse_result.PErr(e) ->
      case e:
        error.ParseLowercaseTypeName("color", _) -> ""
        _ -> should.fail("expected ParseLowercaseTypeName(\"color\")")

// ── Multiple error accumulation ───────────────────────────────────────────────

pub fn parse_multi_error_two_bad_fns_test() -> String:
  let src = string.join([
    "fn 123() -> Int:",
    "  42",
    "fn Uppercase() -> Int:",
    "  1"
  ], "\n")
  case parse_multi(src):
    parser.ParseOk(_) -> should.fail("expected parse errors")
    parser.ParseErrors(errs) ->
      case list.length(errs):
        2 -> ""
        n -> should.fail("expected 2 errors, got " <> int.to_string(n))

pub fn parse_multi_error_bad_fn_then_valid_test() -> String:
  let src = string.join([
    "fn 123() -> Int:",
    "  42",
    "fn valid() -> Int:",
    "  1"
  ], "\n")
  case parse_multi(src):
    parser.ParseOk(_) -> should.fail("expected parse errors")
    parser.ParseErrors(errs) ->
      case list.length(errs):
        1 -> ""
        n -> should.fail("expected 1 error, got " <> int.to_string(n))

pub fn parse_multi_error_valid_then_bad_then_valid_test() -> String:
  let src = string.join([
    "fn first() -> Int:",
    "  1",
    "fn 999() -> Int:",
    "  2",
    "fn last() -> Int:",
    "  3"
  ], "\n")
  case parse_multi(src):
    parser.ParseOk(_) -> should.fail("expected parse errors")
    parser.ParseErrors(errs) ->
      case list.length(errs):
        1 -> ""
        n -> should.fail("expected 1 error, got " <> int.to_string(n))

pub fn parse_multi_error_bad_type_and_bad_fn_test() -> String:
  let src = string.join([
    "type lowercase:",
    "  A",
    "fn Uppercase() -> Int:",
    "  1"
  ], "\n")
  case parse_multi(src):
    parser.ParseOk(_) -> should.fail("expected parse errors")
    parser.ParseErrors(errs) ->
      case list.length(errs):
        2 -> ""
        n -> should.fail("expected 2 errors, got " <> int.to_string(n))

pub fn parse_multi_error_all_valid_test() -> String:
  let src = string.join([
    "fn foo() -> Int:",
    "  1",
    "fn bar() -> Int:",
    "  2"
  ], "\n")
  case parse_multi(src):
    parser.ParseErrors(_) -> should.fail("should have succeeded")
    parser.ParseOk(m) ->
      case list.length(module_fns(m)):
        2 -> ""
        n -> should.fail("expected 2 functions, got " <> int.to_string(n))
