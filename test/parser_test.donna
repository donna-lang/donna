// ── Expression parsing: precedence ───────────────────────────────────────────

pub fn parse_precedence_mul_before_add_test() -> String:
  // 1 + 2 * 3  should parse as  1 + (2 * 3)
  case parse_src("const x = 1 + 2 * 3"):
    parse_result.PErr(_) -> should.fail("parse failed")
    parse_result.POk(m, _) ->
      case module_consts(m):
        [ast.Const(_, _, _, ast.BinOp(ast.BAdd, ast.IntLit("1", _), ast.BinOp(ast.BMul, _, _, _), _), _)] -> ""
        _ -> should.fail("expected Add(1, Mul(2,3)) — mul binds tighter")

pub fn parse_precedence_parens_test() -> String:
  // (1 + 2) * 3 — parens override precedence
  case parse_src("const x = (1 + 2) * 3"):
    parse_result.PErr(_) -> should.fail("parse failed")
    parse_result.POk(m, _) ->
      case module_consts(m):
        [ast.Const(_, _, _, ast.BinOp(ast.BMul, ast.BinOp(ast.BAdd, _, _, _), _, _), _)] -> ""
        _ -> should.fail("expected Mul(Add(1,2), 3)")

pub fn parse_precedence_compare_after_add_test() -> String:
  // 1 + 2 == 3 parses as (1 + 2) == 3
  case parse_src("const x = 1 + 2 == 3"):
    parse_result.PErr(_) -> should.fail("parse failed")
    parse_result.POk(m, _) ->
      case module_consts(m):
        [ast.Const(_, _, _, ast.BinOp(ast.BEq, ast.BinOp(ast.BAdd, _, _, _), _, _), _)] -> ""
        _ -> should.fail("expected Eq(Add(1,2), 3)")

// ── Expression parsing: function calls ───────────────────────────────────────

pub fn parse_call_no_args_test() -> String:
  case parse_src("fn main():\n  foo()"):
    parse_result.PErr(_) -> should.fail("parse failed")
    parse_result.POk(m, _) ->
      case module_fns(m):
        [ast.Function(_, _, _, _, ast.Block([ast.ExprStmt(ast.Call(ast.Var("foo", _), [], _), _)], _), _)] -> ""
        _ -> should.fail("expected Call(foo, [])")

pub fn parse_call_one_arg_test() -> String:
