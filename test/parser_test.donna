// Tests for the Donna stage2 parser.
//
// Tests parse complete source snippets via the lexer → parser pipeline.
// Every language construct gets at least one success case; error paths get
// explicit failure tests so regressions in error messages are caught early.
//
// Pattern: each test calls `parse_src` and pattern-matches on the result.
// "" means pass; a non-empty string is the failure message.

import compiler/lexer/lexer
import compiler/parser/parser
import compiler/parser/parse_result
import compiler/parser/ast
import utilities/location
import errors/error
import donna/list
import donna/option
import donna/string
import donna/int
import unittest/should

// ── Helpers ───────────────────────────────────────────────────────────────────

// Lex then parse a source snippet.
// Converts ParseOutput to single-error ParseResult for existing tests.
fn parse_src(src: String) -> parse_result.ParseResult(ast.Module):
  case lexer.lex(src, "test"):
    lexer.LexErrors(_) ->
      parse_result.PErr(error.ParseUnexpectedToken("lex error", "source", location.zero("test")))
    lexer.LexOk(toks) ->
      case parser.parse(toks):
        parser.ParseOk(m) -> parse_result.POk(m, [])
        parser.ParseErrors(errs) ->
          case errs:
            [e, ..] -> parse_result.PErr(e)
            [] -> parse_result.PErr(error.ParseUnexpectedToken("unknown", "source", location.zero("test")))

// Lex then parse, returning the full ParseOutput for multi-error tests.
fn parse_multi(src: String) -> parser.ParseOutput(ast.Module):
  case lexer.lex(src, "test"):
    lexer.LexErrors(_) ->
      parser.ParseErrors([error.ParseUnexpectedToken("lex error", "source", location.zero("test"))])
    lexer.LexOk(toks) ->
      parser.parse(toks)

fn module_imports(m: ast.Module) -> List(ast.Import):
  case m:
    ast.Module(_, imps, _, _, _) -> imps

fn module_consts(m: ast.Module) -> List(ast.Const):
  case m:
    ast.Module(_, _, cs, _, _) -> cs

fn module_type_defs(m: ast.Module) -> List(ast.TypeDef):
  case m:
    ast.Module(_, _, _, tds, _) -> tds

fn module_fns(m: ast.Module) -> List(ast.Function):
  case m:
    ast.Module(_, _, _, _, fs) -> fs

fn import_alias(imp: ast.Import) -> String:
  case imp:
    ast.Import(_, alias, _) -> alias

fn fn_name(f: ast.Function) -> String:
  case f:
    ast.Function(name, _, _, _, _, _) -> name
    ast.ExternalFn(name, _, _, _, _, _, _) -> name

// ── Empty module ──────────────────────────────────────────────────────────────

pub fn parse_empty_module_test() -> String:
  case parse_src(""):
    parse_result.PErr(_) -> should.fail("empty source should parse to empty module")
    parse_result.POk(_, _) -> ""

pub fn parse_whitespace_only_test() -> String:
  case parse_src("   \n\n   "):
    parse_result.PErr(_) -> should.fail("whitespace-only source should parse ok")
    parse_result.POk(_, _) -> ""

// ── Import declarations ───────────────────────────────────────────────────────

pub fn parse_simple_import_test() -> String:
  case parse_src("import donna/string"):
    parse_result.PErr(_) -> should.fail("parse failed")
    parse_result.POk(m, _) ->
      case module_imports(m):
        [ast.Import(["donna", "string"], "string", _)] -> ""
        _ -> should.fail("expected Import([donna, string], string)")

pub fn parse_import_alias_test() -> String:
  case parse_src("import donna/string as str"):
    parse_result.PErr(_) -> should.fail("parse failed")
    parse_result.POk(m, _) ->
      case module_imports(m):
        [ast.Import(["donna", "string"], "str", _)] -> ""
        _ -> should.fail("expected alias 'str'")

pub fn parse_multi_segment_import_test() -> String:
  case parse_src("import a/b/c/d"):
    parse_result.PErr(_) -> should.fail("parse failed")
    parse_result.POk(m, _) ->
      case module_imports(m):
        [ast.Import(["a", "b", "c", "d"], "d", _)] -> ""
        _ -> should.fail("expected 4-segment import with alias 'd'")

pub fn parse_multiple_imports_test() -> String:
  let src = "import donna/string\nimport donna/list\nimport donna/int"
  case parse_src(src):
    parse_result.PErr(_) -> should.fail("parse failed")
    parse_result.POk(m, _) ->
      module_imports(m) |> should.length_list(3)

pub fn parse_import_aliases_with_list_assertions_test() -> String:
  let src = "import donna/string as str\nimport donna/list\nimport compiler/parser/ast"
  case parse_src(src):
    parse_result.PErr(_) -> should.fail("parse failed")
    parse_result.POk(m, _) ->
      let aliases = list.map(module_imports(m), import_alias)
      should.because(
        should.all([
          should.length_list(aliases, 3),
          should.contains_string_value(aliases, "str"),
          should.contains_string_value(aliases, "list"),
          should.contains_string_value(aliases, "ast")
        ]),
        "import aliases should preserve explicit aliases and derive default aliases from the final path segment"
      )

// ── Constant declarations ─────────────────────────────────────────────────────

pub fn parse_const_int_test() -> String:
  case parse_src("const x = 42"):
    parse_result.PErr(_) -> should.fail("parse failed")
    parse_result.POk(m, _) ->
      case module_consts(m):
        [ast.Const("x", False, option.None, ast.IntLit("42", _), _)] -> ""
        _ -> should.fail("expected Const(x, false, None, IntLit(42))")

pub fn parse_pub_const_test() -> String:
  case parse_src("pub const pi = 3.14"):
    parse_result.PErr(_) -> should.fail("parse failed")
    parse_result.POk(m, _) ->
      case module_consts(m):
        [ast.Const("pi", True, option.None, ast.FloatLit("3.14", _), _)] -> ""
        _ -> should.fail("expected pub const pi = 3.14")

pub fn parse_const_with_annotation_test() -> String:
  case parse_src("const msg: String = \"hello\""):
    parse_result.PErr(_) -> should.fail("parse failed")
    parse_result.POk(m, _) ->
      case module_consts(m):
        [ast.Const("msg", False, option.Some(ast.TyName("String", [], _)), ast.StringLit("hello", _), _)] -> ""
        _ -> should.fail("expected annotated const")

pub fn parse_const_bool_true_test() -> String:
  case parse_src("const flag = True"):
    parse_result.PErr(_) -> should.fail("parse failed")
    parse_result.POk(m, _) ->
      case module_consts(m):
        [ast.Const("flag", False, option.None, ast.BoolLit(True, _), _)] -> ""
        _ -> should.fail("expected BoolLit(True)")

pub fn parse_const_bool_false_test() -> String:
  case parse_src("const flag = False"):
    parse_result.PErr(_) -> should.fail("parse failed")
    parse_result.POk(m, _) ->
      case module_consts(m):
        [ast.Const("flag", False, option.None, ast.BoolLit(False, _), _)] -> ""
        _ -> should.fail("expected BoolLit(False)")

// ── Type definitions ──────────────────────────────────────────────────────────

pub fn parse_nullary_type_test() -> String:
  case parse_src("type Color:\n  Red\n  Green\n  Blue"):
    parse_result.PErr(_) -> should.fail("parse failed")
    parse_result.POk(m, _) ->
      case module_type_defs(m):
        [ast.TypeDef("Color", False, False, [], ctors, _)] ->
          case list.length(ctors):
            3 -> ""
            n -> should.fail("expected 3 constructors, got " <> int.to_string(n))
        _ -> should.fail("expected TypeDef Color")

pub fn parse_pub_type_test() -> String:
  case parse_src("pub type Foo:\n  Bar"):
    parse_result.PErr(_) -> should.fail("parse failed")
    parse_result.POk(m, _) ->
      case module_type_defs(m):
        [ast.TypeDef("Foo", True, False, [], _, _)] -> ""
        _ -> should.fail("expected pub TypeDef")

pub fn parse_opaque_type_test() -> String:
  case parse_src("pub opaque type Token:\n  Token(kind: String)"):
    parse_result.PErr(_) -> should.fail("parse failed")
    parse_result.POk(m, _) ->
      case module_type_defs(m):
        [ast.TypeDef("Token", True, True, [], _, _)] -> ""
        _ -> should.fail("expected opaque TypeDef")

pub fn parse_parameterised_type_test() -> String:
  case parse_src("pub type Option(a):\n  None\n  Some(a)"):
    parse_result.PErr(_) -> should.fail("parse failed")
    parse_result.POk(m, _) ->
      case module_type_defs(m):
        [ast.TypeDef("Option", True, False, ["a"], ctors, _)] ->
          case list.length(ctors):
            2 -> ""
            n -> should.fail("expected 2 constructors, got " <> int.to_string(n))
        _ -> should.fail("expected Option(a) with 2 constructors")

pub fn parse_type_with_named_fields_test() -> String:
  case parse_src("pub type Point:\n  Point(x: Int, y: Int)"):
    parse_result.PErr(_) -> should.fail("parse failed")
    parse_result.POk(m, _) ->
      case module_type_defs(m):
        [ast.TypeDef("Point", True, False, [], [ast.ConstructorDef("Point", ["x", "y"], _, _)], _)] -> ""
        _ -> should.fail("expected TypeDef Point with named fields [x, y]")

pub fn parse_two_param_type_test() -> String:
  case parse_src("pub type Result(a, e):\n  Ok(a)\n  Error(e)"):
    parse_result.PErr(_) -> should.fail("parse failed")
    parse_result.POk(m, _) ->
      case module_type_defs(m):
        [ast.TypeDef("Result", True, False, ["a", "e"], ctors, _)] ->
          case list.length(ctors):
            2 -> ""
            n -> should.fail("expected 2 constructors, got " <> int.to_string(n))
        _ -> should.fail("expected Result(a, e)")

// ── Function declarations ─────────────────────────────────────────────────────

pub fn parse_simple_fn_test() -> String:
  case parse_src("fn double(x: Int) -> Int:\n  x * 2"):
    parse_result.PErr(_) -> should.fail("parse failed")
    parse_result.POk(m, _) ->
      case module_fns(m):
        [ast.Function("double", False, [ast.Param("x", _, _)], option.Some(_), _, _)] -> ""
        _ -> should.fail("expected fn double(x: Int) -> Int")

pub fn parse_pub_fn_test() -> String:
  case parse_src("pub fn greet(name: String) -> String:\n  \"Hello\""):
    parse_result.PErr(_) -> should.fail("parse failed")
    parse_result.POk(m, _) ->
      case module_fns(m):
        [ast.Function("greet", True, _, _, _, _)] -> ""
        _ -> should.fail("expected pub fn")

pub fn parse_fn_no_params_test() -> String:
  case parse_src("fn answer() -> Int:\n  42"):
    parse_result.PErr(_) -> should.fail("parse failed")
    parse_result.POk(m, _) ->
      case module_fns(m):
        [ast.Function("answer", False, [], option.Some(_), _, _)] -> ""
        _ -> should.fail("expected fn answer() -> Int with no params")

pub fn parse_fn_no_return_type_test() -> String:
  case parse_src("fn side(x: Int):\n  x"):
    parse_result.PErr(_) -> should.fail("parse failed")
    parse_result.POk(m, _) ->
      case module_fns(m):
        [ast.Function("side", False, _, option.None, _, _)] -> ""
        _ -> should.fail("expected fn without return type")

pub fn parse_fn_multiple_params_test() -> String:
  case parse_src("fn add(x: Int, y: Int) -> Int:\n  x + y"):
    parse_result.PErr(_) -> should.fail("parse failed")
    parse_result.POk(m, _) ->
      case module_fns(m):
        [ast.Function("add", False, params, _, _, _)] ->
          params |> should.length_list(2)
        _ -> should.fail("expected fn add")

pub fn parse_fn_multiline_params_test() -> String:
  case parse_src("fn foo(\n  x: Int,\n  y: Int\n) -> Int:\n  x + y"):
    parse_result.PErr(_) -> should.fail("parse failed — multiline params should work")
    parse_result.POk(m, _) ->
      case module_fns(m):
        [ast.Function("foo", False, params, _, _, _)] ->
          params |> should.length_list(2)
        _ -> should.fail("expected fn foo")

pub fn parse_function_names_with_list_assertions_test() -> String:
  let src = "@external(\"c\", \"puts\")\npub fn puts(s: String) -> Int\nfn local() -> Int:\n  1"
  case parse_src(src):
    parse_result.PErr(_) -> should.fail("parse failed")
    parse_result.POk(m, _) ->
      let names = list.map(module_fns(m), fn_name)
      should.all([
        should.not_empty_list(names),
        should.length_list(names, 2),
        should.contains_string_value(names, "puts"),
        should.contains_string_value(names, "local")
      ])

pub fn parse_external_fn_test() -> String:
  case parse_src("@external(\"c\", \"puts\")\npub fn puts(s: String) -> Int"):
    parse_result.PErr(_) -> should.fail("parse failed")
    parse_result.POk(m, _) ->
      case module_fns(m):
        [ast.ExternalFn("puts", True, _, _, "c", "puts", _)] -> ""
        _ -> should.fail("expected ExternalFn(puts, True, c, puts)")

pub fn parse_external_fn_private_test() -> String:
  case parse_src("@external(\"c\", \"sqrt\")\nfn c_sqrt(x: Float) -> Float"):
    parse_result.PErr(_) -> should.fail("parse failed")
    parse_result.POk(m, _) ->
      case module_fns(m):
        [ast.ExternalFn("c_sqrt", False, _, _, "c", "sqrt", _)] -> ""
        _ -> should.fail("expected private ExternalFn")

