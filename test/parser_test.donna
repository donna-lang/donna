    parse_result.POk(m, _) ->
      case module_fns(m):
        [ast.Function(_, _, _, _, ast.Block([ast.ExprStmt(ast.Case(_, arms, _), _)], _), _)] ->
          case arms:
            [ast.CaseClause(_, option.Some(_), _, _), ast.CaseClause(_, option.None, _, _)] -> ""
            _ -> should.fail("expected guard in first arm, no guard in second")
        _ -> should.fail("expected Case with guard")

pub fn parse_inline_case_test() -> String:
