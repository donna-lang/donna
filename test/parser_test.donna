// ── Expression parsing: case ─────────────────────────────────────────────────

pub fn parse_case_simple_test() -> String:
  case parse_src("fn f(x: Bool) -> Int:\n  case x:\n    True -> 1\n    False -> 0"):
    parse_result.PErr(_) -> should.fail("parse failed")
    parse_result.POk(m, _) ->
      case module_fns(m):
        [ast.Function(_, _, _, _, ast.Block([ast.ExprStmt(ast.Case(ast.Var("x", _), arms, _), _)], _), _)] ->
          case list.length(arms):
            2 -> ""
            n -> should.fail("expected 2 case arms, got " <> int.to_string(n))
        _ -> should.fail("expected Case expression")

pub fn parse_case_with_guard_test() -> String:
  case parse_src("fn f(x: Int) -> Int:\n  case x:\n    n if n > 0 -> n\n    _ -> 0"):
