pub fn comp_ceql_test() -> String:
  should.equal_string(il.display_comp(il.Ceql), "ceql")

pub fn comp_ceqw_test() -> String:
  should.equal_string(il.display_comp(il.Ceqw), "ceqw")

pub fn comp_sltl_test() -> String:
  should.equal_string(il.display_comp(il.Sltl), "csltl")

pub fn comp_sgtw_test() -> String:
  should.equal_string(il.display_comp(il.Sgtw), "csgtw")

pub fn comp_cned_test() -> String:
  should.equal_string(il.display_comp(il.Cned), "cned")

