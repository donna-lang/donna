pub fn abi_word_test() -> String:
  should.equal_string(il.into_abi(il.Word), "w")

pub fn abi_long_test() -> String:
  should.equal_string(il.into_abi(il.Long), "l")

pub fn abi_single_test() -> String:
  should.equal_string(il.into_abi(il.Single), "s")

pub fn abi_double_test() -> String:
  should.equal_string(il.into_abi(il.Double), "d")

pub fn abi_zero_promoted_to_word_test() -> String:
  should.equal_string(il.into_abi(il.Zero), "w")

pub fn abi_byte_promoted_to_word_test() -> String:
  should.equal_string(il.into_abi(il.Byte), "w")

