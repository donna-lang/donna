// Tests for compiler/codegen/il — QBE intermediate language display functions.

import compiler/codegen/il
import donna/option
import unittest/should

// ── display_value ─────────────────────────────────────────────────────────────

pub fn display_temporary_test() -> String:
  should.equal_string(il.display_value(il.Temporary("x")), "%x")

pub fn display_global_test() -> String:
  should.equal_string(il.display_value(il.Global("main")), "$main")

pub fn display_const_test() -> String:
  should.equal_string(il.display_value(il.Const(42)), "42")

pub fn display_const_zero_test() -> String:
  should.equal_string(il.display_value(il.Const(0)), "0")

pub fn display_const_bits_test() -> String:
  should.equal_string(il.display_value(il.ConstBits(1234)), "1234")

// ── display_type ──────────────────────────────────────────────────────────────

pub fn display_type_word_test() -> String:
  should.equal_string(il.display_type(il.Word), "w")

pub fn display_type_long_test() -> String:
  should.equal_string(il.display_type(il.Long), "l")

pub fn display_type_single_test() -> String:
  should.equal_string(il.display_type(il.Single), "s")

pub fn display_type_double_test() -> String:
  should.equal_string(il.display_type(il.Double), "d")

pub fn display_type_zero_test() -> String:
  should.equal_string(il.display_type(il.Zero), "z")

pub fn display_type_byte_test() -> String:
  should.equal_string(il.display_type(il.Byte), "b")

