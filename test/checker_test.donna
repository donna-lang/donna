// Tests for the Donna stage2 type checker.
//
// Tests type-check complete source snippets via the lex → parse → check pipeline.
// Tests verify that expressions get the right types, type definitions register
// their constructors, and extract_interface exports the right bindings.
//
// Note: stage2 requires indented function bodies — `fn f() -> T:\n  expr`.
// Inline bodies `fn f() -> T: expr` are not supported by the stage2 parser.

import compiler/lexer/lexer
import compiler/parser/parser
import compiler/parser/ast
import compiler/typesystem/checker
import compiler/typesystem/types
import compiler/typesystem/typed_ast
import utilities/location
import errors/error
import donna/result
import donna/list
import donna/option
import donna/string
import donna/int
import unittest/should

// ── Helpers ───────────────────────────────────────────────────────────────────

fn check_src(src: String) -> result.Result(typed_ast.TypedModule, List(error.DonnaError)):
  case lexer.lex(src, "test"):
    lexer.LexErrors(errs) ->
      result.Error(errs)
    lexer.LexOk(toks) ->
      case parser.parse(toks):
        parser.ParseErrors(errs) ->
          result.Error(errs)
        parser.ParseOk(m) ->
          checker.check_module(m, "test")

fn typed_fns(m: typed_ast.TypedModule) -> List(typed_ast.TypedFunction):
  case m:
    typed_ast.TypedModule(_, fns, _, _, _) -> fns

fn typed_consts(m: typed_ast.TypedModule) -> List(typed_ast.TypedConstant):
  case m:
    typed_ast.TypedModule(_, _, cs, _, _) -> cs

fn typed_type_defs(m: typed_ast.TypedModule) -> List(typed_ast.TypedTypeDef):
  case m:
    typed_ast.TypedModule(_, _, _, tds, _) -> tds

fn typed_ctor_info(m: typed_ast.TypedModule) -> List(#(String, #(String, List(types.Type), Int))):
  case m:
    typed_ast.TypedModule(_, _, _, _, info) -> info

fn fn_ret_type(f: typed_ast.TypedFunction) -> types.Type:
  case f:
    typed_ast.TypedFunction(_, _, _, ret, _, _, _) -> ret

fn fn_body(f: typed_ast.TypedFunction) -> types.TypedExpr:
  case f:
    typed_ast.TypedFunction(_, _, _, _, body, _, _) -> body

fn fn_name_of(f: typed_ast.TypedFunction) -> String:
  case f:
    typed_ast.TypedFunction(name, _, _, _, _, _, _) -> name

fn fn_is_pub(f: typed_ast.TypedFunction) -> Bool:
  case f:
    typed_ast.TypedFunction(_, is_pub, _, _, _, _, _) -> is_pub

fn fn_type_of(f: typed_ast.TypedFunction) -> types.Type:
  case f:
    typed_ast.TypedFunction(_, _, _, _, _, _, fn_type) -> fn_type

fn fn_params_of(f: typed_ast.TypedFunction) -> List(#(String, types.Type)):
  case f:
    typed_ast.TypedFunction(_, _, params, _, _, _, _) -> params

fn fn_external_info(f: typed_ast.TypedFunction) -> option.Option(#(String, String)):
  case f:
    typed_ast.TypedFunction(_, _, _, _, _, ext, _) -> ext

fn const_name_of(c: typed_ast.TypedConstant) -> String:
  case c:
    typed_ast.TypedConstant(name, _, _, _) -> name

fn const_type_of(c: typed_ast.TypedConstant) -> types.Type:
  case c:
    typed_ast.TypedConstant(_, _, t, _) -> t

fn typedef_name(td: typed_ast.TypedTypeDef) -> String:
  case td:
    typed_ast.TypedTypeDef(name, _, _) -> name

fn typedef_ctors(td: typed_ast.TypedTypeDef) -> List(typed_ast.TypedConstructor):
  case td:
    typed_ast.TypedTypeDef(_, _, ctors) -> ctors

fn ctor_name_of(c: typed_ast.TypedConstructor) -> String:
  case c:
    typed_ast.TypedConstructor(name, _, _) -> name

fn ctor_tag_of(c: typed_ast.TypedConstructor) -> Int:
  case c:
    typed_ast.TypedConstructor(_, _, tag) -> tag

fn ctor_fields_of(c: typed_ast.TypedConstructor) -> List(types.Type):
  case c:
    typed_ast.TypedConstructor(_, fields, _) -> fields

fn iface_bindings_of(iface: typed_ast.ModuleInterface) -> List(#(String, types.Type)):
  case iface:
    typed_ast.ModuleInterface(bs, _) -> bs

fn iface_ctor_info_of(iface: typed_ast.ModuleInterface) -> List(#(String, #(String, List(types.Type), Int))):
  case iface:
    typed_ast.ModuleInterface(_, ci) -> ci

fn type_str(t: types.Type) -> String:
  types.type_to_string(t)

fn binding_type(bs: List(#(String, types.Type)), name: String) -> option.Option(types.Type):
  case bs:
    [] -> option.None
    [#(k, v), ..rest] ->
      case string.equal(k, name):
        True  -> option.Some(v)
        False -> binding_type(rest, name)

// ── Module-level checks ───────────────────────────────────────────────────────

pub fn check_empty_module_test() -> String:
  case check_src(""):
    result.Error(_) -> should.fail("empty module should type-check ok")
    result.Ok(m) -> list.length(typed_fns(m)) |> should.equal_int(0)

pub fn check_single_fn_count_test() -> String:
  case check_src("fn f() -> Int:\n  42"):
    result.Error(_) -> should.fail("single fn should type-check ok")
    result.Ok(m) -> list.length(typed_fns(m)) |> should.equal_int(1)

pub fn check_multi_fn_count_test() -> String:
  let src = "fn a() -> Int:\n  1\nfn b() -> Int:\n  2\nfn c() -> Int:\n  3"
  case check_src(src):
    result.Error(_) -> should.fail("three fns should type-check ok")
    result.Ok(m) -> list.length(typed_fns(m)) |> should.equal_int(3)

// ── Function return types ─────────────────────────────────────────────────────

pub fn check_int_lit_ret_type_test() -> String:
  case check_src("fn f() -> Int:\n  42"):
    result.Error(_) -> should.fail("expected Ok")
    result.Ok(m) ->
      case typed_fns(m):
        [f, ..] -> type_str(fn_ret_type(f)) |> should.equal_string("Int")
        [] -> should.fail("no functions")

pub fn check_float_lit_ret_type_test() -> String:
  case check_src("fn f() -> Float:\n  3.14"):
    result.Error(_) -> should.fail("expected Ok")
    result.Ok(m) ->
      case typed_fns(m):
        [f, ..] -> type_str(fn_ret_type(f)) |> should.equal_string("Float")
        [] -> should.fail("no functions")

