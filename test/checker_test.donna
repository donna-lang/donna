// ── Mixed module ──────────────────────────────────────────────────────────────

pub fn check_full_module_test() -> String:
  let src = "pub type Result(a, e):\n  Ok(a)\n  Err(e)\n\npub const zero = 0\n\npub fn identity(x: Int) -> Int:\n  x"
  case check_src(src):
    result.Error(_) -> should.fail("expected Ok")
    result.Ok(m) ->
      let r1 = list.length(typed_type_defs(m)) |> should.equal_int(1)
      let r2 = list.length(typed_consts(m)) |> should.equal_int(1)
      let r3 = list.length(typed_fns(m)) |> should.equal_int(1)
      r1 <> r2 <> r3

