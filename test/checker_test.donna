        [] -> should.fail("no functions")

pub fn check_generic_call_instantiates_int_test() -> String:
  let src = "fn identity(x: a) -> a:\n  x\n\nfn f() -> Int:\n  identity(42)"
  case check_src(src):
    result.Error(_) -> should.fail("expected Ok")
    result.Ok(m) ->
      case typed_fns(m):
        [_, f, ..] ->
          type_str(types.typed_expr_type(fn_body(f))) |> should.equal_string("Int")
        _ -> should.fail("expected two functions")

