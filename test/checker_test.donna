// ── Function signature types ──────────────────────────────────────────────────

pub fn check_fn_type_no_params_test() -> String:
  case check_src("fn f() -> Int:\n  42"):
    result.Error(_) -> should.fail("expected Ok")
    result.Ok(m) ->
      case typed_fns(m):
        [f, ..] -> type_str(fn_type_of(f)) |> should.equal_string("fn() -> Int")
        [] -> should.fail("no functions")

pub fn check_fn_type_with_params_test() -> String:
  case check_src("fn add(x: Int, y: Int) -> Int:\n  x + y"):
    result.Error(_) -> should.fail("expected Ok")
    result.Ok(m) ->
      case typed_fns(m):
        [f, ..] -> type_str(fn_type_of(f)) |> should.equal_string("fn(Int, Int) -> Int")
        [] -> should.fail("no functions")

pub fn check_fn_params_test() -> String:
  case check_src("fn f(x: Int, y: String) -> Bool:\n  True"):
    result.Error(_) -> should.fail("expected Ok")
    result.Ok(m) ->
      case typed_fns(m):
        [f, ..] ->
          let params = fn_params_of(f)
          list.length(params) |> should.equal_int(2)
        [] -> should.fail("no functions")

pub fn check_pub_fn_test() -> String:
  case check_src("pub fn f() -> Int:\n  1"):
    result.Error(_) -> should.fail("expected Ok")
    result.Ok(m) ->
      case typed_fns(m):
        [f, ..] -> fn_is_pub(f) |> should.is_true()
        [] -> should.fail("no functions")

pub fn check_private_fn_test() -> String:
  case check_src("fn f() -> Int:\n  1"):
    result.Error(_) -> should.fail("expected Ok")
    result.Ok(m) ->
      case typed_fns(m):
        [f, ..] -> fn_is_pub(f) |> should.is_false()
        [] -> should.fail("no functions")

