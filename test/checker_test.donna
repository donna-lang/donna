// ── Lambda expressions ────────────────────────────────────────────────────────

pub fn check_lambda_type_test() -> String:
  let src = "fn f() -> fn(Int) -> Int:\n  fn(x: Int) -> x + 1"
  case check_src(src):
    result.Error(_) -> should.fail("expected Ok")
    result.Ok(m) ->
      case typed_fns(m):
        [func, ..] -> type_str(types.typed_expr_type(fn_body(func))) |> should.equal_string("fn(Int) -> Int")
        [] -> should.fail("no functions")

pub fn check_lambda_no_params_type_test() -> String:
  let src = "fn f() -> fn() -> String:\n  fn() -> \"hi\""
  case check_src(src):
    result.Error(_) -> should.fail("expected Ok")
    result.Ok(m) ->
      case typed_fns(m):
        [func, ..] -> type_str(types.typed_expr_type(fn_body(func))) |> should.equal_string("fn() -> String")
        [] -> should.fail("no functions")

