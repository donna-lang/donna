pub fn check_pipe_desugaring_test() -> String:
  let src = "fn double(x: Int) -> Int:\n  x * 2\nfn f() -> Int:\n  5 |> double"
  case check_src(src):
    result.Error(_) -> should.fail("expected Ok")
    result.Ok(m) -> list.length(typed_fns(m)) |> should.equal_int(2)

// ── Interface extraction ──────────────────────────────────────────────────────

pub fn extract_iface_pub_fn_test() -> String:
  let src = "pub fn greet() -> String:\n  \"hi\""
  case check_src(src):
    result.Error(_) -> should.fail("expected Ok")
    result.Ok(m) ->
      let iface = checker.extract_interface(m)
      let bs = iface_bindings_of(iface)
      case binding_type(bs, "greet"):
        option.Some(t) -> type_str(t) |> should.equal_string("fn() -> String")
        option.None -> should.fail("greet not in interface")

pub fn extract_iface_private_fn_excluded_test() -> String:
  let src = "fn secret() -> Int:\n  42"
  case check_src(src):
    result.Error(_) -> should.fail("expected Ok")
    result.Ok(m) ->
      let iface = checker.extract_interface(m)
      let bs = iface_bindings_of(iface)
      case binding_type(bs, "secret"):
        option.Some(_) -> should.fail("private fn should not be in interface")
        option.None -> ""

pub fn extract_iface_pub_const_test() -> String:
  let src = "pub const version = \"1.0\""
