// ── Case expressions ──────────────────────────────────────────────────────────

pub fn check_case_bool_type_test() -> String:
  let src = "fn f(x: Int) -> Bool:\n  case x:\n    0 -> False\n    _ -> True"
  case check_src(src):
    result.Error(_) -> should.fail("expected Ok")
    result.Ok(m) ->
      case typed_fns(m):
        [f, ..] -> type_str(types.typed_expr_type(fn_body(f))) |> should.equal_string("Bool")
        [] -> should.fail("no functions")

pub fn check_case_string_type_test() -> String:
  let src = "fn f(b: Bool) -> String:\n  case b:\n    True -> \"yes\"\n    False -> \"no\""
  case check_src(src):
    result.Error(_) -> should.fail("expected Ok")
    result.Ok(m) ->
      case typed_fns(m):
        [f, ..] -> type_str(types.typed_expr_type(fn_body(f))) |> should.equal_string("String")
        [] -> should.fail("no functions")

pub fn check_case_with_guard_test() -> String:
  let src = "fn f(x: Int) -> String:\n  case x:\n    n if n > 0 -> \"pos\"\n    _ -> \"other\""
  case check_src(src):
    result.Error(_) -> should.fail("expected Ok")
    result.Ok(m) -> list.length(typed_fns(m)) |> should.equal_int(1)

// Pattern binding gives fresh type vars; use literal body to test case type.
pub fn check_case_tuple_pattern_type_test() -> String:
  let src = "fn f(t: #(Int, Bool)) -> Int:\n  case t:\n    #(_, _) -> 42"
  case check_src(src):
    result.Error(_) -> should.fail("expected Ok")
    result.Ok(m) ->
      case typed_fns(m):
        [f, ..] -> type_str(types.typed_expr_type(fn_body(f))) |> should.equal_string("Int")
        [] -> should.fail("no functions")

pub fn check_case_list_pattern_test() -> String:
  let src = "fn f(xs: List(Int)) -> Int:\n  case xs:\n    [] -> 0\n    [x, ..] -> x"
  case check_src(src):
    result.Error(_) -> should.fail("expected Ok")
    result.Ok(m) -> list.length(typed_fns(m)) |> should.equal_int(1)

// ── Custom type definitions ───────────────────────────────────────────────────

pub fn check_simple_adt_test() -> String:
  let src = "type Color:\n  Red\n  Green\n  Blue"
  case check_src(src):
    result.Error(_) -> should.fail("expected Ok")
    result.Ok(m) -> list.length(typed_type_defs(m)) |> should.equal_int(1)

pub fn check_adt_constructor_count_test() -> String:
  let src = "type Color:\n  Red\n  Green\n  Blue"
  case check_src(src):
    result.Error(_) -> should.fail("expected Ok")
    result.Ok(m) ->
      case typed_type_defs(m):
        [td, ..] -> list.length(typedef_ctors(td)) |> should.equal_int(3)
        [] -> should.fail("no type defs")

pub fn check_adt_constructor_tags_test() -> String:
  let src = "type Color:\n  Red\n  Green\n  Blue"
  case check_src(src):
    result.Error(_) -> should.fail("expected Ok")
    result.Ok(m) ->
      case typed_type_defs(m):
        [td, ..] ->
          case typedef_ctors(td):
            [r, g, b] ->
              let r1 = ctor_tag_of(r) |> should.equal_int(0)
              let r2 = ctor_tag_of(g) |> should.equal_int(1)
              let r3 = ctor_tag_of(b) |> should.equal_int(2)
              r1 <> r2 <> r3
            _ -> should.fail("expected 3 constructors")
        [] -> should.fail("no type defs")

pub fn check_adt_constructor_names_test() -> String:
  let src = "type Color:\n  Red\n  Green\n  Blue"
  case check_src(src):
    result.Error(_) -> should.fail("expected Ok")
    result.Ok(m) ->
      case typed_type_defs(m):
        [td, ..] ->
          case typedef_ctors(td):
            [r, g, b] ->
              let r1 = ctor_name_of(r) |> should.equal_string("Red")
              let r2 = ctor_name_of(g) |> should.equal_string("Green")
              let r3 = ctor_name_of(b) |> should.equal_string("Blue")
              r1 <> r2 <> r3
            _ -> should.fail("expected 3 constructors")
        [] -> should.fail("no type defs")

pub fn check_adt_with_fields_test() -> String:
  let src = "type Shape:\n  Circle(Int)\n  Rect(Int, Int)"
  case check_src(src):
    result.Error(_) -> should.fail("expected Ok")
    result.Ok(m) ->
      case typed_type_defs(m):
        [td, ..] ->
          case typedef_ctors(td):
            [circle, rect] ->
              let r1 = list.length(ctor_fields_of(circle)) |> should.equal_int(1)
              let r2 = list.length(ctor_fields_of(rect)) |> should.equal_int(2)
              r1 <> r2
            _ -> should.fail("expected 2 constructors")
        [] -> should.fail("no type defs")

pub fn check_adt_field_types_test() -> String:
  let src = "type Pair:\n  Pair(Int, String)"
  case check_src(src):
    result.Error(_) -> should.fail("expected Ok")
    result.Ok(m) ->
      case typed_type_defs(m):
        [td, ..] ->
          case typedef_ctors(td):
            [ctor] ->
              case ctor_fields_of(ctor):
                [t1, t2] ->
                  let r1 = type_str(t1) |> should.equal_string("Int")
                  let r2 = type_str(t2) |> should.equal_string("String")
                  r1 <> r2
                _ -> should.fail("expected 2 fields")
            _ -> should.fail("expected 1 constructor")
        [] -> should.fail("no type defs")

pub fn check_parameterized_adt_test() -> String:
  let src = "type Maybe(a):\n  Nothing\n  Just(a)"
  case check_src(src):
    result.Error(_) -> should.fail("expected Ok")
    result.Ok(m) ->
      case typed_type_defs(m):
        [td, ..] ->
          case typedef_ctors(td):
            [nothing, just] ->
              let r1 = list.length(ctor_fields_of(nothing)) |> should.equal_int(0)
              let r2 = list.length(ctor_fields_of(just)) |> should.equal_int(1)
              r1 <> r2
            _ -> should.fail("expected 2 constructors")
        [] -> should.fail("no type defs")

pub fn check_adt_not_in_ctor_info_when_private_test() -> String:
  let src = "type Color:\n  Red\n  Green"
  case check_src(src):
    result.Error(_) -> should.fail("expected Ok")
    result.Ok(m) -> list.length(typed_ctor_info(m)) |> should.equal_int(0)

pub fn check_pub_adt_in_ctor_info_test() -> String:
  let src = "pub type Color:\n  Red\n  Green"
  case check_src(src):
    result.Error(_) -> should.fail("expected Ok")
    result.Ok(m) -> list.length(typed_ctor_info(m)) |> should.equal_int(2)

