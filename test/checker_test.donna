// ── External functions ────────────────────────────────────────────────────────

pub fn check_external_fn_test() -> String:
  let src = "@external(\"c\", \"printf\")\npub fn printf(fmt: String) -> Int"
  case check_src(src):
    result.Error(_) -> should.fail("expected Ok")
    result.Ok(m) ->
      case typed_fns(m):
        [f, ..] ->
          case fn_external_info(f):
            option.Some(#(lang, sym)) ->
              let r1 = lang |> should.equal_string("c")
              let r2 = sym |> should.equal_string("printf")
              r1 <> r2
            option.None -> should.fail("expected external info")
        [] -> should.fail("no functions")

pub fn check_external_fn_ret_type_test() -> String:
  let src = "@external(\"c\", \"strlen\")\nfn strlen(s: String) -> Int"
  case check_src(src):
    result.Error(_) -> should.fail("expected Ok")
    result.Ok(m) ->
      case typed_fns(m):
        [f, ..] -> type_str(fn_ret_type(f)) |> should.equal_string("Int")
        [] -> should.fail("no functions")

