// ── EOF boundary safety ───────────────────────────────────────────────────────

pub fn lex_single_slash_at_eof_test() -> String:
  case lex_ok("/"):
    [token.TokSlash, token.TokEof] -> ""
    _ -> should.fail("/ at EOF should be Slash")

pub fn lex_single_eq_at_eof_test() -> String:
  case lex_ok("="):
    [token.TokEqual, token.TokEof] -> ""
    _ -> should.fail("= at EOF should be Equal")

pub fn lex_single_lt_at_eof_test() -> String:
  case lex_ok("<"):
    [token.TokLt, token.TokEof] -> ""
    _ -> should.fail("< at EOF should be Lt")

pub fn lex_single_gt_at_eof_test() -> String:
  case lex_ok(">"):
    [token.TokGt, token.TokEof] -> ""
    _ -> should.fail("> at EOF should be Gt")

pub fn lex_single_minus_at_eof_test() -> String:
  case lex_ok("-"):
    [token.TokMinus, token.TokEof] -> ""
    _ -> should.fail("- at EOF should be Minus")

pub fn lex_single_pipe_at_eof_test() -> String:
  case lex_ok("|"):
    [token.TokVBar, token.TokEof] -> ""
    _ -> should.fail("| at EOF should be VBar")

pub fn lex_single_bang_at_eof_test() -> String:
  case lex_ok("!"):
    [token.TokBang, token.TokEof] -> ""
    _ -> should.fail("! at EOF should be Bang")

// ── Comments ──────────────────────────────────────────────────────────────────

pub fn lex_line_comment_gives_eof_test() -> String:
  case lex_ok("// this is a comment"):
    [token.TokEof] -> ""
    _ -> should.fail("comment only → Eof")

pub fn lex_comment_then_token_test() -> String:
  case lex_ok("// comment\n42"):
    [token.TokInt("42"), token.TokEof] -> ""
    _ -> should.fail("expected Int(42) Eof after comment")

pub fn lex_doc_comment_gives_module_doc_test() -> String:
  case lex_ok("//// Hello"):
    [token.TokModuleDoc("Hello"), token.TokEof] -> ""
    _ -> should.fail("expected ModuleDoc(Hello) Eof")

pub fn lex_doc_comment_trims_whitespace_test() -> String:
  case lex_ok("////   trimmed"):
    [token.TokModuleDoc("trimmed"), token.TokEof] -> ""
    _ -> should.fail("expected ModuleDoc(trimmed) Eof")

pub fn lex_triple_slash_is_plain_comment_test() -> String:
  case lex_ok("/// doc comment\n42"):
    [token.TokInt("42"), token.TokEof] -> ""
    _ -> should.fail("/// is a plain comment, not module doc")

pub fn lex_token_before_comment_test() -> String:
  case lex_ok("42 // inline"):
    [token.TokInt("42"), token.TokEof] -> ""
    _ -> should.fail("expected Int(42) Eof before inline comment")

// ── Indentation: Newline ──────────────────────────────────────────────────────

pub fn lex_two_names_same_level_get_newline_test() -> String:
  case lex_ok("a\nb"):
    [token.TokName("a"), token.TokNewline, token.TokName("b"), token.TokEof] -> ""
    _ -> should.fail("expected a Newline b Eof")

pub fn lex_blank_line_ignored_test() -> String:
  case lex_ok("a\n\nb"):
    [token.TokName("a"), token.TokNewline, token.TokName("b"), token.TokEof] -> ""
    _ -> should.fail("blank line should be ignored")

pub fn lex_crlf_newline_test() -> String:
  case lex_ok("a\r\nb"):
    [token.TokName("a"), token.TokNewline, token.TokName("b"), token.TokEof] -> ""
    _ -> should.fail("CRLF should work like LF")

// ── Indentation: Indent / Dedent ──────────────────────────────────────────────

pub fn lex_indent_emits_indent_token_test() -> String:
  case lex_ok("a\n  b"):
    [token.TokName("a"), token.TokNewline, token.TokIndent, token.TokName("b"), token.TokDedent, token.TokEof] -> ""
    _ -> should.fail("expected Newline Indent b Dedent")

pub fn lex_dedent_back_to_zero_test() -> String:
  case lex_ok("a\n  b\nc"):
    [token.TokName("a"), token.TokNewline, token.TokIndent, token.TokName("b"), token.TokNewline, token.TokDedent, token.TokName("c"), token.TokEof] -> ""
    _ -> should.fail("expected correct dedent sequence")

pub fn lex_nested_indent_test() -> String:
  case lex_ok("a\n  b\n    c"):
    [token.TokName("a"), token.TokNewline, token.TokIndent, token.TokName("b"), token.TokNewline, token.TokIndent, token.TokName("c"), token.TokDedent, token.TokDedent, token.TokEof] -> ""
    _ -> should.fail("expected two-level indent")

pub fn lex_first_line_no_newline_before_indent_test() -> String:
  case lex_ok("a\n  b"):
    [token.TokName(_), token.TokNewline, token.TokIndent, ..] -> ""
    _ -> should.fail("first indent should emit Newline then Indent")

// ── Indentation: continuation ─────────────────────────────────────────────────

pub fn lex_pipe_continuation_no_indent_test() -> String:
  case lex_ok("a\n|> b"):
    [token.TokName("a"), token.TokPipe, token.TokName("b"), token.TokEof] -> ""
    _ -> should.fail("|> continuation should suppress Newline/Indent")

pub fn lex_ltgt_continuation_no_indent_test() -> String:
  case lex_ok("a\n<> b"):
    [token.TokName("a"), token.TokLtGt, token.TokName("b"), token.TokEof] -> ""
    _ -> should.fail("<> continuation should suppress Newline/Indent")

// ── Errors ────────────────────────────────────────────────────────────────────

pub fn lex_unexpected_char_is_error_test() -> String:
  lex_err("$") |> should.is_true()

pub fn lex_bare_ampersand_is_error_test() -> String:
  lex_err("&") |> should.is_true()

pub fn lex_valid_input_is_not_error_test() -> String:
  lex_err("42") |> should.is_false()

// ── Span positions ────────────────────────────────────────────────────────────

pub fn span_first_token_line_is_one_test() -> String:
  case lexer.lex("42", "f"):
    lexer.LexErrors(_) -> should.fail("expected Ok")
    lexer.LexOk(toks) ->
      case toks:
        [#(_, sp), ..] -> should.equal_int(location.pos_line(location.span_start(sp)), 1)
        [] -> should.fail("empty")

pub fn span_first_token_col_is_one_test() -> String:
  case lexer.lex("42", "f"):
    lexer.LexErrors(_) -> should.fail("expected Ok")
    lexer.LexOk(toks) ->
      case toks:
        [#(_, sp), ..] -> should.equal_int(location.pos_col(location.span_start(sp)), 1)
        [] -> should.fail("empty")

pub fn span_indented_token_col_is_correct_test() -> String:
  case lexer.lex("   x", "f"):
    lexer.LexErrors(_) -> should.fail("expected Ok")
    lexer.LexOk(toks) ->
      case toks:
        [#(_, sp), ..] -> should.equal_int(location.pos_col(location.span_start(sp)), 4)
        [] -> should.fail("empty")

pub fn span_file_label_is_set_test() -> String:
  case lexer.lex("x", "my.donna"):
    lexer.LexErrors(_) -> should.fail("expected Ok")
    lexer.LexOk(toks) ->
      case toks:
        [#(_, sp), ..] -> should.equal_string(location.span_file(sp), "my.donna")
        [] -> should.fail("empty")

// ── Mini programs ─────────────────────────────────────────────────────────────

pub fn lex_fn_declaration_test() -> String:
  let toks = lex_ok("pub fn add(x: Int) -> Int:")
  let strs = tok_strings(toks)
  let has_pub = list.any(strs, is_pub)
  let has_fn  = list.any(strs, is_fn)
  let has_arr = list.any(strs, is_arrow)
  should.all([
    should.is_true(has_pub),
    should.is_true(has_fn),
    should.is_true(has_arr)
  ])

pub fn lex_import_statement_test() -> String:
  case lex_ok("import donna/string"):
    [token.TokImport, token.TokName("donna"), token.TokSlash, token.TokName("string"), token.TokEof] -> ""
    _ -> should.fail("expected Import Name(donna) Slash Name(string) Eof")

pub fn lex_type_definition_test() -> String:
  let toks = lex_ok("pub type Option(a):")
  let strs = tok_strings(toks)
  should.all([
    should.is_true(list.any(strs, is_type)),
    should.is_true(list.any(strs, is_pub))
  ])

pub fn lex_external_attribute_test() -> String:
  case lex_ok("@external"):
    [token.TokAt, token.TokExternal, token.TokEof] -> ""
    _ -> should.fail("expected At External Eof")

// ── Helpers for mini program tests ────────────────────────────────────────────

fn is_pub(s: String) -> Bool:
  string.equal(s, "pub")

fn is_fn(s: String) -> Bool:
  string.equal(s, "fn")

fn is_arrow(s: String) -> Bool:
  string.equal(s, "->")

fn is_type(s: String) -> Bool:
  string.equal(s, "type")

// ── Escape sequence error tests ───────────────────────────────────────────────

pub fn lex_invalid_escape_is_error_test() -> String:
  should.is_true(lex_err("\"\\q\""))

pub fn lex_invalid_escape_z_is_error_test() -> String:
  should.is_true(lex_err("\"\\z\""))

pub fn lex_valid_escapes_are_ok_test() -> String:
  should.not_empty_list(lex_ok("\"\\n\\t\\r\\a\\b\\f\\v\\e\\\\\\\"\""))

pub fn lex_invalid_hex_escape_is_error_test() -> String:
  should.is_true(lex_err("\"\\xGG\""))

pub fn lex_invalid_hex_escape_partial_is_error_test() -> String:
  should.is_true(lex_err("\"\\x4G\""))

pub fn lex_valid_hex_escape_is_ok_test() -> String:
  case lex_ok("\"\\x41\""):
    [token.TokString("A"), token.TokEof] -> ""
    _ -> should.fail("expected TokString(A)")

pub fn lex_invalid_unicode_escape_empty_is_error_test() -> String:
  should.is_true(lex_err("\"\\u{}\""))

pub fn lex_invalid_unicode_escape_bad_chars_is_error_test() -> String:
  should.is_true(lex_err("\"\\u{GG}\""))

pub fn lex_valid_unicode_escape_is_ok_test() -> String:
  case lex_ok("\"\\u{41}\""):
    [token.TokString("A"), token.TokEof] -> ""
    _ -> should.fail("expected TokString(A)")

// ── Empty number literal error tests ─────────────────────────────────────────

pub fn lex_empty_hex_literal_is_error_test() -> String:
  should.is_true(lex_err("0x"))

pub fn lex_empty_binary_literal_is_error_test() -> String:
  should.is_true(lex_err("0b"))

pub fn lex_valid_hex_literal_is_ok_test() -> String:
  case lex_ok("0xFF"):
    [token.TokInt("255"), token.TokEof] -> ""
    _ -> should.fail("expected TokInt(255)")

pub fn lex_valid_binary_literal_is_ok_test() -> String:
  case lex_ok("0b1010"):
    [token.TokInt("10"), token.TokEof] -> ""
    _ -> should.fail("expected TokInt(10)")
