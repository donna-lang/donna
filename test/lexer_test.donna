    _ -> should.fail("expected TokBool(False) Eof")

pub fn lex_true_not_upper_name_test() -> String:
  case lex_ok("True"):
    [token.TokUpperName(_), ..] -> should.fail("True should not be UpperName")
    _ -> ""

pub fn lex_false_not_upper_name_test() -> String:
  case lex_ok("False"):
    [token.TokUpperName(_), ..] -> should.fail("False should not be UpperName")
    _ -> ""

