// Tests for the Donna stage2 lexer — covers every token kind, escape
// sequence, indentation rule, span position, and error case.

import compiler/lexer/lexer
import compiler/lexer/token
import utilities/location
import donna/string
import donna/list
import unittest/should

// ── Helpers ───────────────────────────────────────────────────────────────────

fn lex_ok(src: String) -> List(token.Token):
  case lexer.lex(src, "test"):
    lexer.LexErrors(_) -> []
    lexer.LexOk(toks) -> list.map(toks, tok_of_pair)

fn tok_of_pair(pair: #(token.Token, location.Span)) -> token.Token:
  case pair:
    #(t, _) -> t

fn lex_err(src: String) -> Bool:
  case lexer.lex(src, "test"):
    lexer.LexErrors(_) -> True
    lexer.LexOk(_)     -> False

fn tok_strings(toks: List(token.Token)) -> List(String):
  list.map(toks, token.to_string)

fn lex_strings(src: String) -> List(String):
  tok_strings(lex_ok(src))

// ── Empty input ───────────────────────────────────────────────────────────────

pub fn lex_empty_gives_eof_test() -> String:
  case lex_ok(""):
    [token.TokEof] -> ""
    _ -> should.fail("expected [Eof]")

pub fn lex_whitespace_only_gives_eof_test() -> String:
  case lex_ok("   "):
    [token.TokEof] -> ""
    _ -> should.fail("expected [Eof]")

pub fn lex_tabs_only_gives_eof_test() -> String:
  case lex_ok("\t\t"):
    [token.TokEof] -> ""
    _ -> should.fail("expected [Eof]")

pub fn lex_crlf_only_gives_eof_test() -> String:
  case lex_ok("\r\n"):
    [token.TokEof] -> ""
    _ -> should.fail("expected [Eof]")

// ── Integer literals ──────────────────────────────────────────────────────────

pub fn lex_single_int_test() -> String:
  case lex_ok("42"):
    [token.TokInt("42"), token.TokEof] -> ""
    _ -> should.fail("expected Int(42) Eof")

pub fn lex_zero_test() -> String:
  case lex_ok("0"):
    [token.TokInt("0"), token.TokEof] -> ""
    _ -> should.fail("expected Int(0) Eof")

pub fn lex_large_int_test() -> String:
  case lex_ok("1000000"):
    [token.TokInt("1000000"), token.TokEof] -> ""
    _ -> should.fail("expected Int(1000000) Eof")

pub fn lex_int_with_underscores_stripped_test() -> String:
  case lex_ok("1_000_000"):
    [token.TokInt("1000000"), token.TokEof] -> ""
    _ -> should.fail("expected Int(1000000) Eof")

pub fn lex_hex_uppercase_test() -> String:
  case lex_ok("0xFF"):
    [token.TokInt("255"), token.TokEof] -> ""
    _ -> should.fail("expected Int(255) Eof")

pub fn lex_hex_lowercase_test() -> String:
  case lex_ok("0xff"):
    [token.TokInt("255"), token.TokEof] -> ""
    _ -> should.fail("expected Int(255) Eof")

pub fn lex_hex_zero_test() -> String:
  case lex_ok("0x0"):
    [token.TokInt("0"), token.TokEof] -> ""
    _ -> should.fail("expected Int(0) Eof")

pub fn lex_hex_with_underscores_test() -> String:
  case lex_ok("0xFF_FF"):
    [token.TokInt("65535"), token.TokEof] -> ""
    _ -> should.fail("expected Int(65535) Eof")

pub fn lex_binary_test() -> String:
  case lex_ok("0b1010"):
    [token.TokInt("10"), token.TokEof] -> ""
    _ -> should.fail("expected Int(10) Eof")

pub fn lex_binary_zero_test() -> String:
  case lex_ok("0b0"):
    [token.TokInt("0"), token.TokEof] -> ""
    _ -> should.fail("expected Int(0) Eof")

pub fn lex_binary_all_ones_test() -> String:
  case lex_ok("0b1111"):
    [token.TokInt("15"), token.TokEof] -> ""
    _ -> should.fail("expected Int(15) Eof")

pub fn lex_binary_with_underscores_test() -> String:
  case lex_ok("0b1111_0000"):
    [token.TokInt("240"), token.TokEof] -> ""
    _ -> should.fail("expected Int(240) Eof")

// ── Float literals ────────────────────────────────────────────────────────────

pub fn lex_float_test() -> String:
  case lex_ok("3.14"):
    [token.TokFloat("3.14"), token.TokEof] -> ""
    _ -> should.fail("expected Float(3.14) Eof")

pub fn lex_float_zero_test() -> String:
  case lex_ok("0.5"):
    [token.TokFloat("0.5"), token.TokEof] -> ""
    _ -> should.fail("expected Float(0.5) Eof")

pub fn lex_int_dot_no_digit_is_int_and_dot_test() -> String:
  case lex_ok("1."):
    [token.TokInt("1"), token.TokDot, token.TokEof] -> ""
    _ -> should.fail("expected Int(1) Dot Eof")

pub fn lex_float_with_underscores_test() -> String:
  case lex_ok("1_000.5"):
    [token.TokFloat("1000.5"), token.TokEof] -> ""
    _ -> should.fail("expected Float(1000.5) Eof")

// ── String literals ───────────────────────────────────────────────────────────

pub fn lex_empty_string_test() -> String:
  case lex_ok("\"\""):
    [token.TokString(s), token.TokEof] -> should.equal_string(s, "")
    _ -> should.fail("expected String() Eof")

pub fn lex_simple_string_test() -> String:
  case lex_ok("\"hello\""):
    [token.TokString(s), token.TokEof] -> should.equal_string(s, "hello")
    _ -> should.fail("expected String(hello) Eof")

pub fn lex_string_escape_newline_test() -> String:
  case lex_ok("\"a\\nb\""):
    [token.TokString(s), token.TokEof] -> should.equal_int(string.length(s), 3)
    _ -> should.fail("expected String with newline")

pub fn lex_string_escape_tab_test() -> String:
  case lex_ok("\"a\\tb\""):
    [token.TokString(s), token.TokEof] -> should.equal_int(string.length(s), 3)
    _ -> should.fail("expected String with tab")

pub fn lex_string_escape_backslash_test() -> String:
  case lex_ok("\"a\\\\b\""):
    [token.TokString(s), token.TokEof] -> should.equal_string(s, "a\\b")
    _ -> should.fail("expected String(a\\b)")

pub fn lex_string_escape_quote_test() -> String:
  case lex_ok("\"a\\\"b\""):
    [token.TokString(s), token.TokEof] -> should.equal_string(s, "a\"b")
    _ -> should.fail("expected String(a\"b)")

pub fn lex_string_escape_cr_test() -> String:
  case lex_ok("\"a\\rb\""):
    [token.TokString(s), token.TokEof] -> should.equal_int(string.length(s), 3)
    _ -> should.fail("expected String with cr")

pub fn lex_string_escape_ascii_bell_test() -> String:
  case lex_ok("\"\\a\""):
    [token.TokString(s), token.TokEof] -> should.equal_int(string.char_at(s, 0), 7)
    _ -> should.fail("expected ASCII bell from \\a")

pub fn lex_string_escape_ascii_backspace_test() -> String:
  case lex_ok("\"\\b\""):
    [token.TokString(s), token.TokEof] -> should.equal_int(string.char_at(s, 0), 8)
    _ -> should.fail("expected ASCII backspace from \\b")

pub fn lex_string_escape_ascii_form_feed_test() -> String:
  case lex_ok("\"\\f\""):
    [token.TokString(s), token.TokEof] -> should.equal_int(string.char_at(s, 0), 12)
    _ -> should.fail("expected ASCII form feed from \\f")

pub fn lex_string_escape_ascii_vertical_tab_test() -> String:
  case lex_ok("\"\\v\""):
    [token.TokString(s), token.TokEof] -> should.equal_int(string.char_at(s, 0), 11)
    _ -> should.fail("expected ASCII vertical tab from \\v")

pub fn lex_string_escape_ascii_escape_test() -> String:
  case lex_ok("\"\\e\""):
    [token.TokString(s), token.TokEof] -> should.equal_int(string.char_at(s, 0), 27)
    _ -> should.fail("expected ASCII escape from \\e")

pub fn lex_string_hex_escape_H_test() -> String:
  case lex_ok("\"\\x48\""):
    [token.TokString("H"), token.TokEof] -> ""
    _ -> should.fail("expected String(H) from \\x48")

pub fn lex_string_hex_escape_a_test() -> String:
  case lex_ok("\"\\x61\""):
    [token.TokString("a"), token.TokEof] -> ""
    _ -> should.fail("expected String(a) from \\x61")

pub fn lex_string_hex_escape_zero_test() -> String:
  case lex_ok("\"\\x00\""):
    [token.TokString(_), token.TokEof] -> ""
    _ -> should.fail("expected String from \\x00")

pub fn lex_string_hex_escape_ascii_escape_test() -> String:
  case lex_ok("\"\\x1b\""):
    [token.TokString(s), token.TokEof] -> should.equal_int(string.char_at(s, 0), 27)
    _ -> should.fail("expected ASCII escape from \\x1b")

pub fn lex_string_hex_escape_ascii_del_test() -> String:
  case lex_ok("\"\\x7f\""):
    [token.TokString(s), token.TokEof] -> should.equal_int(string.char_at(s, 0), 127)
    _ -> should.fail("expected ASCII DEL from \\x7f")

pub fn lex_string_unicode_4digit_H_test() -> String:
  case lex_ok("\"\\u0048\""):
    [token.TokString("H"), token.TokEof] -> ""
    _ -> should.fail("expected String(H) from \\u0048")

pub fn lex_string_unicode_4digit_a_test() -> String:
  case lex_ok("\"\\u0061\""):
    [token.TokString("a"), token.TokEof] -> ""
    _ -> should.fail("expected String(a) from \\u0061")

pub fn lex_string_unicode_brace_test() -> String:
  case lex_ok("\"\\u{48}\""):
    [token.TokString("H"), token.TokEof] -> ""
    _ -> should.fail("expected String(H) from \\u{48}")

pub fn lex_unterminated_string_is_error_test() -> String:
  lex_err("\"hello") |> should.is_true()

pub fn lex_unterminated_string_mid_escape_is_error_test() -> String:
  lex_err("\"\\") |> should.is_true()

