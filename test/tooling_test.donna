import donna/result
import json
import cli/cli
import tools/fmt/formatter
import tools/lsp/completions
import tools/lsp/code_actions
import tools/lsp/lsp
import tools/lsp/symbols
import unittest/should

pub fn formatter_format_simple_test() -> String:
  let src = "pub type Foo:\n  Foo\n"
  case formatter.format_source(src, "test"):
    result.Error(e) -> should.fail(e)
    result.Ok(formatted) ->
      should.equal_string(formatted, src)

pub fn lsp_command_starts_only_for_bare_lsp_test() -> String:
  let r1 = should.equal_bool(cli.should_start_lsp([#("", "lsp")]), True)
  let r2 = should.equal_bool(cli.should_start_lsp([#("", "lsp"), #("help", "")]), False)
  let r3 = should.equal_bool(cli.should_start_lsp([#("", "lsp"), #("", "--help")]), False)
  let r4 = should.equal_bool(cli.should_start_lsp([]), False)
  r1 <> r2 <> r3 <> r4

pub fn lsp_completions_include_text_edit_test() -> String:
  let items = completions.completions(".", "f", lsp.range(2, 4, 2, 5))
  let encoded = json.encode(items)
  let r1 = should.contains_string(encoded, "\"textEdit\"")
  let r2 = should.contains_string(encoded, "\"newText\":\"fn\"")
  let r3 = should.contains_string(encoded, "\"character\":4")
  let r4 = should.contains_string(encoded, "\"character\":5")
  let r5 = should.contains_string(encoded, "\"isIncomplete\":true")
  r1 <> r2 <> r3 <> r4 <> r5

pub fn lsp_completions_include_imported_symbols_test() -> String:
  let source = "import tools/lsp/lsp\n\npub fn main() -> Int:\n  lo\n"
  let items = completions.completions_for_source(".", source, "lo", lsp.range(3, 2, 3, 4))
  let encoded = json.encode(items)
  should.contains_string(encoded, "\"label\":\"location\"")

pub fn lsp_document_symbols_include_imported_symbols_test() -> String:
  let found = symbols.document_symbols("src/tools/lsp/completions.donna", ".")
  let encoded = json.encode(found)
  should.contains_string(encoded, "\"name\":\"location\"")

pub fn lsp_code_action_remove_unused_import_test() -> String:
  let source = "import donna/list\n\npub fn main() -> Nil:\n  Nil\n"
  let params = code_action_params(lsp.range(0, 13, 0, 17))
  let encoded = json.encode(code_actions.actions("file:///test.donna", source, params))
  let r1 = should.contains_string(encoded, "\"title\":\"Remove import\"")
  let r2 = should.contains_string(encoded, "\"newText\":\"\"")
  let r3 = should.contains_string(encoded, "\"line\":1")
  r1 <> r2 <> r3

pub fn lsp_code_action_prefix_unused_binding_test() -> String:
  let source = "pub fn main() -> Nil:\n  let name = \"x\"\n  Nil\n"
  let params = code_action_params(lsp.range(1, 6, 1, 10))
  let encoded = json.encode(code_actions.actions("file:///test.donna", source, params))
  let r1 = should.contains_string(encoded, "\"title\":\"Prefix with _\"")
  let r2 = should.contains_string(encoded, "\"newText\":\"_\"")
  let r3 = should.contains_string(encoded, "\"character\":6")
  r1 <> r2 <> r3

pub fn lsp_code_action_replace_echo_test() -> String:
  let source = "//// My module.\n//// More docs.\n\npub fn main() -> Nil:\n  echo \"hello\"\n"
  let params = code_action_params(lsp.range(4, 2, 4, 6))
  let encoded = json.encode(code_actions.actions("file:///test.donna", source, params))
  let r1 = should.contains_string(encoded, "\"title\":\"Replace echo with io.println\"")
  let r2 = should.contains_string(encoded, "import donna/io\\n")
  let r3 = should.contains_string(encoded, "io.println(\\\"hello\\\")")
  let r4 = should.contains_string(encoded, "\"line\":3")
  r1 <> r2 <> r3 <> r4

pub fn lsp_code_action_replace_todo_test() -> String:
  let source = "pub fn main() -> Nil:\n  todo\n"
  let params = code_action_params(lsp.range(1, 2, 1, 6))
  let encoded = json.encode(code_actions.actions("file:///test.donna", source, params))
  let r1 = should.contains_string(encoded, "\"title\":\"Replace todo with panic\"")
  let r2 = should.contains_string(encoded, "panic \\\"TODO\\\"")
  r1 <> r2

fn code_action_params(rng: json.Json) -> json.Json:
  json.Object([
    #("range", rng)
  ])
