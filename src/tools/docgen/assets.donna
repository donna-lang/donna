//// Documentation generator assets.
//// Contains embedded CSS and JavaScript used by generated documentation pages.

pub fn css() -> String:
  "@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap');\n" <> module_doc_code_css() <> "\n:root {\n  --orange: oklch(0.62 0.19 38);\n  --orange-dim: oklch(0.55 0.16 38);\n  --orange-glow: oklch(0.62 0.19 38 / 0.18);\n  --bg: #181818;\n  --bg2: #202020;\n  --bg3: #282828;\n  --border: rgba(255,255,255,0.07);\n  --text: #f5f0ec;\n  --text-dim: rgba(245,240,236,0.52);\n  --sans: 'Space Grotesk', sans-serif;\n  --mono: 'JetBrains Mono', monospace;\n}\nbody.theme-light {\n  --orange: oklch(0.58 0.18 38);\n  --orange-dim: oklch(0.52 0.16 38);\n  --orange-glow: oklch(0.58 0.18 38 / 0.14);\n  --bg: #f7f4f0;\n  --bg2: #eee9e3;\n  --bg3: #ffffff;\n  --border: rgba(24,24,24,0.11);\n  --text: #24201d;\n  --text-dim: rgba(36,32,29,0.58);\n}\n*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\nbody { background: var(--bg); color: var(--text); font-family: var(--sans); font-size: 16px; line-height: 1.6; overflow-x: hidden; }\n\n/* Theme toggle — fixed top-right corner */\n.theme-corner { position: fixed; top: 16px; right: 24px; z-index: 300; }\n.theme-toggle { width: 38px; height: 38px; border: 1px solid var(--border); border-radius: 8px; background: var(--bg3); color: var(--text-dim); cursor: pointer; display: inline-flex; align-items: center; justify-content: center; transition: border-color 0.15s, color 0.15s, background 0.15s; }\n.theme-toggle:hover { border-color: rgba(255,255,255,0.16); color: var(--text); }\nbody.theme-light .theme-toggle:hover { border-color: rgba(24,24,24,0.18); }\n.theme-toggle-icon { width: 16px; height: 16px; border-radius: 50%; background: currentColor; box-shadow: inset -5px -4px 0 var(--bg3); display: block; }\nbody.theme-light .theme-toggle-icon { box-shadow: 0 -7px 0 -5px currentColor, 0 7px 0 -5px currentColor, 7px 0 0 -5px currentColor, -7px 0 0 -5px currentColor, 5px 5px 0 -5px currentColor, -5px -5px 0 -5px currentColor, 5px -5px 0 -5px currentColor, -5px 5px 0 -5px currentColor; }\n\n/* Sidebar burger — shown on mobile */\n.sidebar-burger { display: none; position: fixed; top: 16px; left: 16px; z-index: 300; flex-direction: column; gap: 5px; cursor: pointer; padding: 7px; background: transparent; border: none; border-radius: 8px; }\n.sidebar-burger span { display: block; width: 18px; height: 2px; background: var(--text); border-radius: 2px; transition: transform 0.22s, opacity 0.22s; }\n.sidebar-burger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }\n.sidebar-burger.open span:nth-child(2) { opacity: 0; }\n.sidebar-burger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }\n\n/* Syntax tokens */\n.kw { color: var(--orange); font-weight: 600; }\n.fn { color: oklch(0.74 0.12 200); }\n.str { color: oklch(0.74 0.1 145); }\n.ty { color: oklch(0.72 0.1 260); }\n.cm { color: rgba(245,240,236,0.28); font-style: italic; }\nbody.theme-light .cm { color: rgba(36,32,29,0.42); }\n.pu { color: var(--text-dim); }\n.num { color: oklch(0.72 0.1 300); }\n\n/* Code block decoration dots */\n.dot { width: 10px; height: 10px; border-radius: 50%; }\n.dot-r { background: #ff5f57; }\n.dot-y { background: #febc2e; }\n.dot-g { background: #28c840; }\n\n/* Shared breadcrumb */\n.breadcrumb { display: flex; align-items: center; gap: 8px; color: var(--text-dim); font-family: var(--mono); font-size: 0.8rem; margin-bottom: 32px; }\n.breadcrumb a { color: var(--text-dim); text-decoration: none; transition: color 0.15s; }\n.breadcrumb a:hover { color: var(--orange); }\n.breadcrumb span { opacity: 0.4; }\n\n/* Shared code block */\n.code-block { background: var(--bg3); border: 1px solid var(--border); border-radius: 10px; overflow: hidden; margin: 16px 0; }\n.code-bar { display: flex; align-items: center; gap: 7px; padding: 11px 16px; border-bottom: 1px solid var(--border); background: rgba(0,0,0,0.22); }\n.code-label { color: var(--text-dim); font-family: var(--mono); font-size: 0.7rem; margin-left: 8px; }\n.code-block pre { padding: 0; margin: 0; font-family: var(--mono); font-size: 0.875rem; line-height: 1.82; overflow-x: auto; }\n\n/* ---- INDEX PAGE (page-package) ---- */\n\nbody.page-package .pkg-layout { display: flex; min-height: 100vh; max-width: 1080px; margin: 0 auto; width: 100%; }\n\nbody.page-package .pkg-sidebar { position: fixed; top: 0; left: max(0px, calc(50vw - 540px)); bottom: 0; width: 260px; overflow-y: auto; border-right: 1px solid var(--border); background: var(--bg); padding: 32px 0 48px; scrollbar-width: thin; scrollbar-color: var(--border) transparent; }\nbody.page-package .sidebar-pkg-name { padding: 0 24px; margin-bottom: 4px; font-family: var(--mono); font-size: 1rem; font-weight: 700; color: var(--orange); }\nbody.page-package .sidebar-pkg-ver { padding: 0 24px; margin-bottom: 24px; font-family: var(--mono); font-size: 0.72rem; color: var(--text-dim); }\nbody.page-package .sidebar-section-label { font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--orange); padding: 0 24px; margin: 24px 0 8px; }\nbody.page-package .sidebar-nav { list-style: none; }\nbody.page-package .sidebar-nav a { display: block; padding: 7px 24px; font-size: 0.875rem; color: var(--text-dim); text-decoration: none; border-left: 2px solid transparent; transition: color 0.15s, border-color 0.15s, background 0.15s; }\nbody.page-package .sidebar-nav a:hover { color: var(--text); background: rgba(255,255,255,0.03); }\nbody.page-package .sidebar-nav a.active { color: var(--text); border-left-color: var(--orange); background: rgba(255,255,255,0.03); }\n\nbody.page-package .pkg-spacer { width: 260px; flex-shrink: 0; }\nbody.page-package .pkg-main { flex: 1; min-width: 0; padding: 56px 72px 96px; max-width: 860px; }\n\nbody.page-package .pkg-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 24px; margin-bottom: 40px; flex-wrap: wrap; }\nbody.page-package .pkg-header-left { display: flex; flex-direction: column; gap: 12px; }\nbody.page-package .pkg-title { font-family: var(--mono); font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 700; color: var(--text); letter-spacing: -0.02em; }\nbody.page-package .pkg-title span { color: var(--orange); }\nbody.page-package .pkg-tagline { font-size: 1rem; color: var(--text-dim); line-height: 1.6; max-width: 500px; }\nbody.page-package .pkg-badges { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-top: 4px; }\nbody.page-package .badge-item { display: inline-flex; align-items: center; gap: 6px; font-family: var(--mono); font-size: 0.72rem; padding: 5px 10px; border-radius: 6px; border: 1px solid var(--border); background: var(--bg3); color: var(--text-dim); }\nbody.page-package .pkg-actions { display: flex; flex-direction: column; gap: 10px; align-items: flex-end; flex-shrink: 0; }\nbody.page-package .btn { display: inline-block; padding: 10px 22px; border-radius: 8px; font-family: var(--sans); font-size: 0.875rem; font-weight: 600; cursor: pointer; text-decoration: none; border: none; transition: background 0.18s, transform 0.14s; min-width: 130px; text-align: center; }\nbody.page-package .btn-primary { background: var(--orange); color: var(--text); }\nbody.theme-light.page-package .btn-primary { color: #fff; }\nbody.page-package .btn-primary:hover { background: var(--orange-dim); transform: translateY(-1px); }\nbody.page-package .btn-ghost { background: transparent; color: var(--text-dim); border: 1px solid var(--border); }\nbody.page-package .btn-ghost:hover { border-color: rgba(255,255,255,0.18); color: var(--text); }\n\n/* README prose */\nbody.page-package .readme h1 { font-size: 1.7rem; font-weight: 700; letter-spacing: -0.02em; margin: 0 0 14px; }\nbody.page-package .readme h2 { font-size: 1.3rem; font-weight: 700; margin: 48px 0 12px; padding-top: 48px; border-top: 1px solid var(--border); }\nbody.page-package .readme h2:first-child { margin-top: 0; padding-top: 0; border-top: none; }\nbody.page-package .readme h3 { font-size: 1.05rem; font-weight: 600; margin: 28px 0 10px; }\nbody.page-package .readme p { font-size: 0.9375rem; color: var(--text-dim); line-height: 1.78; margin-bottom: 16px; }\nbody.page-package .readme p strong { color: var(--text); font-weight: 600; }\nbody.page-package .readme ul, body.page-package .readme ol { padding-left: 24px; margin-bottom: 16px; }\nbody.page-package .readme li { font-size: 0.9375rem; color: var(--text-dim); line-height: 1.72; margin-bottom: 6px; }\nbody.page-package .readme a { color: var(--orange); text-decoration: none; border-bottom: 1px solid var(--orange-glow); transition: border-color 0.15s; }\nbody.page-package .readme a:hover { border-bottom-color: var(--orange); }\nbody.page-package .readme a:has(img) { border-bottom: none; }\nbody.page-package .readme img { border: none; outline: none; }\nbody.page-package .readme code { font-family: var(--mono); font-size: 0.85em; color: var(--orange); background: rgba(255,255,255,0.05); padding: 2px 6px; border-radius: 4px; }\nbody.page-package .readme pre { margin: 16px 0; }\nbody.page-package .readme .code-block pre { margin: 0; }\nbody.page-package .readme pre code { display: block; padding: 20px 18px; font-family: var(--mono); font-size: 0.875rem; line-height: 1.82; overflow-x: auto; background: none; color: var(--text-dim); }\nbody.page-package .readme img { max-width: 100%; border-radius: 8px; margin: 8px 0; }\nbody.page-package .readme blockquote { border-left: 3px solid var(--orange-glow); padding: 10px 16px; margin: 16px 0; color: var(--text-dim); font-style: italic; }\nbody.page-package .readme table { width: 100%; border-collapse: collapse; margin: 16px 0; font-size: 0.9rem; }\nbody.page-package .readme th { text-align: left; padding: 8px 12px; border-bottom: 1px solid var(--border); color: var(--text-dim); font-family: var(--mono); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; }\nbody.page-package .readme td { padding: 9px 12px; color: var(--text-dim); border-bottom: 1px solid var(--border); }\n\n@media (max-width: 900px) {\n  body.page-package .pkg-sidebar { display: none; }\n  body.page-package .pkg-sidebar.open { display: block; z-index: 290; padding-top: 64px; }\n  body.page-package .pkg-spacer { display: none; }\n  body.page-package .pkg-main { padding: 64px 24px 64px; }\n  .sidebar-burger { display: flex; }\n}\n\n/* ---- DOCS PAGE (page-package-docs) ---- */\n\nbody.page-package-docs .layout { display: flex; min-height: 100vh; max-width: 1080px; margin: 0 auto; width: 100%; }\n\nbody.page-package-docs .sidebar { position: fixed; top: 0; left: max(0px, calc(50vw - 540px)); bottom: 0; width: 260px; overflow-y: auto; border-right: 1px solid var(--border); background: var(--bg); padding: 32px 0 48px; scrollbar-width: thin; scrollbar-color: var(--border) transparent; }\nbody.page-package-docs .sidebar-back { display: flex; align-items: center; gap: 7px; padding: 0 24px; margin-bottom: 6px; font-size: 0.8rem; color: var(--text-dim); text-decoration: none; transition: color 0.15s; font-family: var(--mono); }\nbody.page-package-docs .sidebar.open { padding-top: 64px; }\nbody.page-package-docs .sidebar-back:hover { color: var(--text); }\nbody.page-package-docs .sidebar-pkg { padding: 0 24px; margin-bottom: 24px; }\nbody.page-package-docs .sidebar-pkg-name { font-family: var(--mono); font-size: 1rem; font-weight: 700; color: var(--orange); }\nbody.page-package-docs .sidebar-pkg-ver { font-family: var(--mono); font-size: 0.72rem; color: var(--text-dim); margin-top: 3px; }\nbody.page-package-docs .sidebar-section-label { font-family: var(--mono); font-size: 0.8rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--orange); padding: 0 24px; margin: 20px 0 6px; }\nbody.page-package-docs .sidebar-subcat { font-family: var(--mono); font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-dim); opacity: 0.6; padding: 0 24px 0 30px; margin: 10px 0 3px; }\nbody.page-package-docs .sidebar-nav { list-style: none; }\nbody.page-package-docs .sidebar-nav a { display: block; padding: 6px 24px; font-size: 1rem; color: var(--text-dim); text-decoration: none; border-left: 2px solid transparent; transition: color 0.15s, border-color 0.15s, background 0.15s; }\nbody.page-package-docs .sidebar-nav a:hover { color: var(--text); background: rgba(255,255,255,0.03); }\nbody.page-package-docs .sidebar-nav a.active { color: var(--text); border-left-color: var(--orange); background: rgba(255,255,255,0.03); }\nbody.page-package-docs .sidebar-nav a.fn-link { font-family: var(--mono); font-size: 0.78rem; padding: 5px 24px 5px 30px; }\nbody.page-package-docs .sidebar-nav a.fn-link:hover { color: var(--orange); }\nbody.page-package-docs .sidebar-nav a.fn-link.active { color: var(--orange); border-left-color: var(--orange); }\n\nbody.page-package-docs .spacer { width: 260px; flex-shrink: 0; }\nbody.page-package-docs .main { flex: 1; min-width: 0; padding: 56px 72px 96px; max-width: 860px; }\n\nbody.page-package-docs .page-head { margin-bottom: 52px; }\nbody.page-package-docs .page-head h1 { font-family: var(--mono); font-size: clamp(1.5rem, 3vw, 1.9rem); font-weight: 700; letter-spacing: -0.02em; margin-bottom: 12px; }\nbody.page-package-docs .page-head h1 span { color: var(--orange); }\nbody.page-package-docs .page-head p { font-size: 1rem; color: var(--text-dim); line-height: 1.72; max-width: 560px; }\nbody.page-package-docs .ver-row { display: flex; align-items: center; gap: 12px; margin-top: 16px; flex-wrap: wrap; }\nbody.page-package-docs .ver-chip { font-family: var(--mono); font-size: 0.72rem; padding: 4px 10px; border-radius: 6px; background: var(--bg3); border: 1px solid var(--border); color: var(--text-dim); }\nbody.page-package-docs .ver-chip.current { background: var(--orange-glow); border-color: var(--orange-glow); color: var(--orange); }\nbody.page-package-docs .ver-chip-link { text-decoration: none; transition: border-color 0.15s, color 0.15s; }\nbody.page-package-docs .ver-chip-link:hover { border-color: rgba(255,255,255,0.18); color: var(--text); }\n\nbody.page-package-docs .module-section { margin-bottom: 72px; }\nbody.page-package-docs .module-section > h2 { font-size: 1.3rem; font-weight: 700; letter-spacing: -0.02em; margin: 56px 0 12px; padding-top: 56px; border-top: 1px solid var(--border); }\nbody.page-package-docs .module-section:first-child > h2 { margin-top: 0; padding-top: 0; border-top: none; }\nbody.page-package-docs .module-doc { margin-bottom: 28px; }\nbody.page-package-docs .module-doc p { font-size: 0.9375rem; color: var(--text-dim); line-height: 1.78; margin-bottom: 12px; }\nbody.page-package-docs .module-doc code { font-family: var(--mono); font-size: 0.85em; color: var(--orange); background: rgba(255,255,255,0.05); padding: 2px 6px; border-radius: 4px; }\n\nbody.page-package-docs .items-section { margin-bottom: 36px; }\nbody.page-package-docs .items-section h3 { font-size: 0.68rem; font-family: var(--mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-dim); margin-bottom: 16px; padding-bottom: 8px; border-bottom: 1px solid var(--border); opacity: 0.7; }\n\nbody.page-package-docs .fn-card { margin-bottom: 36px; padding-bottom: 36px; border-bottom: 1px solid var(--border); }\nbody.page-package-docs .fn-card:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }\nbody.page-package-docs .fn-card .code-block pre code { display: block; padding: 14px 18px; font-family: var(--mono); font-size: 0.875rem; line-height: 1.5; background: none; color: var(--text); overflow-x: auto; }\nbody.page-package-docs .fn-card-body { margin-top: 14px; display: flex; flex-direction: column; gap: 12px; }\nbody.page-package-docs .fn-desc { margin-top: 14px; font-size: 0.9rem; color: var(--text-dim); line-height: 1.68; }\nbody.page-package-docs .fn-desc p { margin-bottom: 8px; }\nbody.page-package-docs .fn-desc p:last-child { margin-bottom: 0; }\nbody.page-package-docs .fn-desc h2, body.page-package-docs .fn-desc h3 { font-size: 0.85rem; font-weight: 600; margin: 12px 0 6px; color: var(--text); }\nbody.page-package-docs .fn-desc code { font-family: var(--mono); font-size: 0.83em; color: var(--orange); background: rgba(255,255,255,0.05); padding: 2px 6px; border-radius: 4px; }\nbody.page-package-docs .fn-desc pre { background: var(--bg3); border: 1px solid var(--border); border-radius: 8px; overflow: hidden; margin: 8px 0; }\nbody.page-package-docs .fn-desc pre code { display: block; padding: 14px 16px; background: none; color: var(--text-dim); overflow-x: auto; font-size: 0.82rem; }\nbody.page-package-docs .fn-desc ul, body.page-package-docs .fn-desc ol { padding-left: 20px; margin-bottom: 8px; }\nbody.page-package-docs .fn-desc li { margin-bottom: 4px; }\n\nbody.page-package-docs .ctor-list { display: flex; flex-direction: column; gap: 8px; }\nbody.page-package-docs .ctor-item { background: var(--bg3); border: 1px solid var(--border); border-radius: 8px; padding: 10px 14px; }\nbody.page-package-docs .ctor-sig { font-family: var(--mono); font-size: 0.82rem; color: var(--text); display: block; margin-bottom: 4px; }\nbody.page-package-docs .ctor-doc { font-size: 0.85rem; color: var(--text-dim); line-height: 1.6; }\nbody.page-package-docs .ctor-doc p { margin: 0; }\n\n.site-footer { text-align: center; padding: 32px 24px; font-size: 0.78rem; color: var(--text-dim); opacity: 0.5; }\n.site-footer a { color: var(--text-dim); text-decoration: none; }\n.site-footer a:hover { color: var(--orange); }\n\n@media (max-width: 900px) {\n  body.page-package-docs .sidebar { display: none; }\n  body.page-package-docs .sidebar.open { display: block; z-index: 290; }\n  body.page-package-docs .spacer { display: none; }\n  body.page-package-docs .main { padding: 64px 24px 64px; }\n  .sidebar-burger { display: flex; }\n}"

fn module_doc_code_css() -> String:
  ".copy-code { margin-left: auto; border: 1px solid var(--border); border-radius: 6px; background: rgba(255,255,255,0.04); color: var(--text-dim); font-family: var(--mono); font-size: 0.68rem; padding: 4px 8px; cursor: pointer; }\n.copy-code:hover { color: var(--text); border-color: rgba(255,255,255,0.18); }\n.hl-kw { color: var(--orange); font-weight: 600; }\n.hl-type { color: oklch(0.72 0.1 260); }\n.hl-constructor { color: oklch(0.76 0.1 250); font-weight: 600; }\n.hl-fn { color: oklch(0.75 0.12 205); }\n.hl-var { color: oklch(0.78 0.08 90); }\n.hl-module { color: oklch(0.74 0.09 185); }\n.hl-op { color: oklch(0.8 0.12 70); font-weight: 600; }\n.hl-str { color: oklch(0.74 0.1 145); }\n.hl-num { color: oklch(0.72 0.1 300); }\n.hl-comment { color: rgba(245,240,236,0.32); font-style: italic; }\nbody.theme-light .hl-comment { color: rgba(36,32,29,0.42); }\nbody.page-package-docs .module-doc pre { background: var(--bg3); border: 1px solid var(--border); border-radius: 8px; overflow: hidden; margin: 12px 0 18px; max-width: 100%; }\nbody.page-package-docs .module-doc pre code { display: block; padding: 14px 16px; background: none; color: var(--text-dim); overflow-x: auto; font-size: 0.82rem; white-space: pre; }\n"

/// Return the JavaScript embedded in generated documentation pages.
pub fn js() -> String:
  "(() => {\n  function setTheme(theme) {\n    var isLight = theme === 'light';\n    document.body.classList.toggle('theme-light', isLight);\n    document.querySelectorAll('[data-theme-toggle]').forEach(function(btn) {\n      btn.setAttribute('aria-label', isLight ? 'Switch to dark theme' : 'Switch to light theme');\n      btn.setAttribute('aria-pressed', String(isLight));\n    });\n  }\n\n  function initThemeToggle() {\n    var saved = localStorage.getItem('donna-theme');\n    var preferred = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';\n    setTheme(saved || preferred);\n    document.querySelectorAll('[data-theme-toggle]').forEach(function(btn) {\n      btn.addEventListener('click', function() {\n        var next = document.body.classList.contains('theme-light') ? 'dark' : 'light';\n        localStorage.setItem('donna-theme', next);\n        setTheme(next);\n      });\n    });\n  }\n\n  function initSidebarBurger() {\n    var burger = document.getElementById('sidebar-burger');\n    var sidebar = document.getElementById('page-sidebar');\n    if (!burger || !sidebar) return;\n    burger.addEventListener('click', function(e) {\n      e.stopPropagation();\n      burger.classList.toggle('open');\n      sidebar.classList.toggle('open');\n    });\n    document.addEventListener('click', function(e) {\n      if (!burger.contains(e.target) && !sidebar.contains(e.target)) {\n        burger.classList.remove('open');\n        sidebar.classList.remove('open');\n      }\n    });\n  }\n\n  function initSidebarSpy(sectionSel, linkSel, fallback) {\n    var sections = document.querySelectorAll(sectionSel);\n    var links = document.querySelectorAll(linkSel);\n    if (!sections.length || !links.length) return;\n    function update() {\n      var y = window.scrollY + 90;\n      var current = fallback || '';\n      sections.forEach(function(s) {\n        if (y >= s.offsetTop) current = s.id || fallback || '';\n      });\n      links.forEach(function(a) {\n        a.classList.toggle('active', a.getAttribute('href') === '#' + current);\n      });\n    }\n    window.addEventListener('scroll', update, { passive: true });\n    update();\n  }\n\n  function initHeadingAnchors() {\n    document.querySelectorAll('.readme h1, .readme h2, .readme h3').forEach(function(h) {\n      if (!h.id) {\n        h.id = h.textContent.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');\n      }\n    });\n  }\n\n  function initCodeBlocks() {\n    document.querySelectorAll('.readme pre').forEach(function(pre) {\n      if (pre.parentElement.classList.contains('code-block')) return;\n      var wrapper = document.createElement('div');\n      wrapper.className = 'code-block';\n      var bar = document.createElement('div');\n      bar.className = 'code-bar';\n      bar.innerHTML = '<div class=\"dot dot-r\"></div><div class=\"dot dot-y\"></div><div class=\"dot dot-g\"></div>';\n      pre.parentNode.insertBefore(wrapper, pre);\n      wrapper.appendChild(bar);\n      wrapper.appendChild(pre);\n    });\n  }\n\n  initThemeToggle();\n  initSidebarBurger();\n  initHeadingAnchors();\n  initCodeBlocks();\n  initSidebarSpy('.page-package .readme h2, .page-package .readme h3', '.page-package .sidebar-nav a', '');\n  initSidebarSpy('.page-package-docs .fn-card[id]', '.page-package-docs .sidebar-nav a', '');\n})();"

/// Return JavaScript for documentation codeblock copy buttons and Donna highlighting.
pub fn codeblock_js() -> String:
  "(() => {
  function esc(s) {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }
  function addCopyBar(pre) {
    if (pre.parentElement && pre.parentElement.classList.contains('code-block')) return;
    var wrapper = document.createElement('div');
    wrapper.className = 'code-block';
    var bar = document.createElement('div');
    bar.className = 'code-bar';
    bar.innerHTML = '<div class=\"dot dot-r\"></div><div class=\"dot dot-y\"></div><div class=\"dot dot-g\"></div><button type=\"button\" class=\"copy-code\" aria-label=\"Copy code\">Copy</button>';
    pre.parentNode.insertBefore(wrapper, pre);
    wrapper.appendChild(bar);
    wrapper.appendChild(pre);
  }
  function highlightDonna(code) {
    var html = esc(code);
    var held = {};
    var heldCount = 0;
    function holdKey(n) {
      var out = '';
      do {
        out = String.fromCharCode(65 + (n % 26)) + out;
        n = Math.floor(n / 26) - 1;
      } while (n >= 0);
      return '@@DONNAHL' + out + '@@';
    }
    function stash(cls, value) {
      var key = holdKey(heldCount++);
      held[key] = '<span class=\"' + cls + '\">' + value + '</span>';
      return key;
    }
    html = html.replace(/(&quot;[^\\n]*?&quot;|\"[^\\n]*?\")/g, function(m) { return stash('hl-str', m); });
    html = html.replace(/(\\/\\/.*)$/gm, function(m) { return stash('hl-comment', m); });
    html = html.replace(/(\\bimport\\s+)([A-Za-z0-9_\\/]+)/g, function(_, kw, mod) { return stash('hl-kw', 'import') + ' ' + stash('hl-module', mod); });
    html = html.replace(/\\b([a-z_][A-Za-z0-9_]*)(?=\\.)/g, function(m) { return stash('hl-module', m); });
    html = html.replace(/(\\|&gt;\\s*)([a-z_][A-Za-z0-9_]*)/g, function(_, op, fn) { return stash('hl-op', op.trim()) + ' ' + stash('hl-fn', fn); });
    html = html.replace(/(\\|&gt;|-&gt;)/g, function(m) { return stash('hl-op', m); });
    html = html.replace(/\\blet\\s+([a-z_][A-Za-z0-9_]*)/g, function(_, name) { return stash('hl-kw', 'let') + ' ' + stash('hl-var', name); });
    html = html.replace(/\\b(echo|panic)\\s+([a-z_][A-Za-z0-9_]*)\\b/g, function(_, kw, name) { return stash('hl-kw', kw) + ' ' + stash('hl-var', name); });
    html = html.replace(/\\bcase\\s+([a-z_][A-Za-z0-9_]*)\\b(?!\\s*\\()/g, function(_, name) { return stash('hl-kw', 'case') + ' ' + stash('hl-var', name); });
    html = html.replace(/\\b(pub|fn|type|const|case|if|opaque|external|echo|panic|todo|as)\\b/g, function(m) { return stash('hl-kw', m); });
    html = html.replace(/\\b([a-z_][A-Za-z0-9_]*)(?=\\s*\\()/g, function(m) { return stash('hl-fn', m); });
    html = html.replace(/\\b([A-Z][A-Za-z0-9_]*)(?=\\s*\\()/g, function(m) { return stash('hl-constructor', m); });
    html = html.replace(/\\b(Int|String|Bool|Float|List|Nil)\\b/g, function(m) { return stash('hl-type', m); });
    html = html.replace(/\\b(True|False)\\b/g, function(m) { return stash('hl-constructor', m); });
    html = html.replace(/\\b([0-9]+)\\b/g, function(m) { return stash('hl-num', m); });
    html = html.replace(/@@DONNAHL[A-Z]+@@/g, function(m) { return held[m]; });
    return html;
  }
  function shouldHighlight(code) {
    return code.classList.contains('language-donna') || /\\b(pub fn|fn |import |pub type|pub const|case |let )\\b/.test(code.textContent);
  }
  function applyDonnaHighlight(code) {
    if (shouldHighlight(code) && !code.dataset.highlighted) {
      addCopyBar(code.parentElement);
      code.innerHTML = highlightDonna(code.textContent);
      code.dataset.highlighted = 'true';
    }
  }
  document.querySelectorAll('.code-block').forEach(function(block) {
    var bar = block.querySelector('.code-bar');
    var code = block.querySelector('pre code');
    if (!bar || !code) return;
    if (!bar.querySelector('.copy-code')) {
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'copy-code';
      btn.setAttribute('aria-label', 'Copy code');
      btn.textContent = 'Copy';
      bar.appendChild(btn);
    }
    applyDonnaHighlight(code);
  });
  document.querySelectorAll('pre code').forEach(function(code) {
    applyDonnaHighlight(code);
  });
  document.addEventListener('click', function(e) {
    if (!e.target.classList.contains('copy-code')) return;
    var block = e.target.closest('.code-block');
    var code = block && block.querySelector('pre code');
    if (!code) return;
    navigator.clipboard.writeText(code.textContent).then(function() {
      e.target.textContent = 'Copied';
      setTimeout(function() { e.target.textContent = 'Copy'; }, 1200);
    });
  });
})();"
