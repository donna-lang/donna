//// Typechecker environment.
//// Stores value bindings, imported module interfaces, import aliases,
//// constructor metadata, and the next fresh type variable id.

import compiler/typesystem/types
import compiler/typesystem/typed_ast
import donna/string
import donna/option

/// Typechecker environment with local bindings, imported modules, aliases, constructors, and fresh variable state.
pub type Env:
  Env(List(#(String, types.TypeScheme)), List(#(String, typed_ast.ModuleInterface)), List(#(String, String)), List(#(String, #(String, List(types.Type), Int))), Int)

/// Create an empty typechecker environment.
pub fn new_env() -> Env:
  Env([], [], [], [], 0)

/// Return the next fresh type variable id.
pub fn env_next_var(e: Env) -> Int:
  case e:
    Env(_, _, _, _, n) -> n

/// Return constructor metadata registered in the environment.
pub fn env_ctor_info(
  e: Env
) -> List(#(String, #(String, List(types.Type), Int))):
  case e:
    Env(_, _, _, ctor_info, _) -> ctor_info

/// Allocate a fresh type variable and advance the environment counter.
pub fn fresh_var(e: Env) -> #(types.Type, Env):
  case e:
    Env(b, m, a, c, n) -> #(types.TTypeVar(n), Env(b, m, a, c, n + 1))

/// Look up a value binding by name.
pub fn env_lookup(e: Env, name: String) -> option.Option(types.Type):
  case e:
    Env(bindings, _, _, _, _) ->
      case lookup_scheme(bindings, name):
        option.None -> option.None
        option.Some(scheme) ->
          case scheme:
            types.Mono(t) -> option.Some(t)
            types.Poly(_, t) -> option.Some(t)

/// Look up an imported module interface by alias.
pub fn env_lookup_module(
  e: Env,
  alias: String
) -> option.Option(typed_ast.ModuleInterface):
  case e:
    Env(_, modules, _, _, _) -> lookup_module(modules, alias)

/// Look up the full import path for a module alias.
pub fn env_lookup_alias(e: Env, alias: String) -> option.Option(String):
  case e:
    Env(_, _, aliases, _, _) -> lookup_string(aliases, alias)

/// Look up constructor metadata by constructor name.
pub fn env_lookup_ctor(
  e: Env,
  name: String
) -> option.Option(#(String, List(types.Type), Int)):
  case e:
    Env(_, _, _, ctor_info, _) -> lookup_ctor(ctor_info, name)

/// Bind a local value name to a monomorphic type.
pub fn env_bind(e: Env, name: String, t: types.Type) -> Env:
  case e:
    Env(bindings, modules, aliases, ctor_info, next_var) ->
      Env(
        [#(name, types.Mono(t)), ..bindings],
        modules,
        aliases,
        ctor_info,
        next_var
      )

/// Register an import alias without adding an interface.
pub fn env_register_alias(e: Env, alias: String, full_path: String) -> Env:
  case e:
    Env(bindings, modules, aliases, ctor_info, next_var) ->
      Env(
        bindings,
        modules,
        [#(alias, full_path), ..aliases],
        ctor_info,
        next_var
      )

/// Add an imported module interface and its alias mapping.
pub fn env_add_module(
  e: Env,
  alias: String,
  full_path: String,
  iface: typed_ast.ModuleInterface
) -> Env:
  case e:
    Env(bindings, modules, aliases, ctor_info, next_var) ->
      Env(
        bindings,
        [#(alias, iface), ..modules],
        [#(alias, full_path), ..aliases],
        ctor_info,
        next_var
      )

/// Add constructor metadata to the environment.
pub fn env_add_ctor(
  e: Env,
  name: String,
  info: #(String, List(types.Type), Int)
) -> Env:
  case e:
    Env(bindings, modules, aliases, ctor_info, next_var) ->
      Env(bindings, modules, aliases, [#(name, info), ..ctor_info], next_var)

fn lookup_scheme(
  pairs: List(#(String, types.TypeScheme)),
  key: String
) -> option.Option(types.TypeScheme):
  case pairs:
    [] -> option.None
    [#(k, v), ..rest] ->
      case string.equal(k, key):
        True -> option.Some(v)
        False -> lookup_scheme(rest, key)

fn lookup_module(
  pairs: List(#(String, typed_ast.ModuleInterface)),
  key: String
) -> option.Option(typed_ast.ModuleInterface):
  case pairs:
    [] -> option.None
    [#(k, v), ..rest] ->
      case string.equal(k, key):
        True -> option.Some(v)
        False -> lookup_module(rest, key)

fn lookup_string(
  pairs: List(#(String, String)),
  key: String
) -> option.Option(String):
  case pairs:
    [] -> option.None
    [#(k, v), ..rest] ->
      case string.equal(k, key):
        True -> option.Some(v)
        False -> lookup_string(rest, key)

fn lookup_ctor(
  pairs: List(#(String, #(String, List(types.Type), Int))),
  key: String
) -> option.Option(#(String, List(types.Type), Int)):
  case pairs:
    [] -> option.None
    [#(k, v), ..rest] ->
      case string.equal(k, key):
        True -> option.Some(v)
        False -> lookup_ctor(rest, key)
