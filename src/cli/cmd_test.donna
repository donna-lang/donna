//// `donna test` command.
//// Builds runtime and dev dependencies, generates a temporary runner, links it,
//// and executes project tests with optional filters.

import donna/files
import donna/path
import donna/list
import donna/string
import donna/shell
import donna/result
import argparse
import cli/help
import utilities/colors
import utilities/logger
import builder/scanner
import builder/tester
import builder/dependencies
import builder/pipeline

@external("c", "exit")
fn process_exit(code: Int) -> Nil

/// Run `donna test`, optionally filtering test names from the command line.
pub fn run(args: List(#(String, String))) -> String:
  case argparse.has(args, "h"):
    True -> help.test_help()
    False ->
      case argparse.has(args, "help"):
        True -> help.test_help()
        False ->
          let #(dir, filters) = parse_test_args(args)
          case scanner.scan(dir):
            scanner.ScanErr(msg) ->
              colors.red("error") <> ": " <> msg
            scanner.ScanOk(project) ->
              do_test(dir, project, filters)

fn do_test(
  dir: String,
  project: scanner.Project,
  filters: List(String)
) -> String:
  let test_src_dir = path.join(dir, "test")
  case files.is_dir(test_src_dir):
    False ->
      colors.dim("no test/ directory in ") <> colors.path(dir)
    True ->
      let test_files = find_donna_files(test_src_dir)
      case list.is_empty(test_files):
        True ->
          colors.dim("no .donna test files found in ") <> colors.path(test_src_dir)
        False ->
          let test_mods = tester.collect_test_modules(test_files)
          let invalid = tester.collect_invalid_public_test_functions(test_files)
          case list.is_empty(invalid):
            False -> invalid_test_names_error(invalid)
            True ->
              case tester.count_total(test_mods) == 0:
                True -> no_tests_error()
                False ->
                  let runner_src = tester.generate_filtered_runner(test_mods, filters)
                  let selected_mods = tester.select_test_modules(test_mods, filters)
                  let selected_test_files = select_test_files(test_files, selected_mods)
                  let build_dir = scanner.project_build_dir(project)
                  let test_dir = scanner.project_test_dir(project)
                  let _ = files.mkdir(build_dir)
                  let _ = files.mkdir(test_dir)
                  let runner_path = path.join(test_dir, "test_runner.donna")
                  let _ = write_if_changed(runner_path, runner_src)
                  build_and_run(
                    dir,
                    project,
                    selected_test_files,
                    test_mods,
                    runner_path,
                    test_dir
                  )

fn build_and_run(
  dir: String,
  project: scanner.Project,
  test_files: List(String),
  _test_mods: List(#(String, List(String))),
  runner_path: String,
  test_dir: String
) -> String:
  let toml_path = path.join(dir, "donna.toml")
  let build_dir = scanner.project_build_dir(project)
  let artifacts_dir = scanner.project_dev_artifacts_dir(project)
  let dev_dir = scanner.project_dev_dir(project)
  let _ = files.mkdir(dev_dir)
  let _ = files.mkdir(artifacts_dir)
  case dependencies.resolve_deps_checked(toml_path, dir):
    result.Error(e) -> e
    result.Ok(deps) ->
      case dependencies.resolve_dev_deps_checked(toml_path, dir):
        result.Error(e) -> e
        result.Ok(raw_dev_deps) ->
          let dev_deps = normalize_dev_deps(project, raw_dev_deps)
          let proj_ffi_objs = pipeline.compile_ffi(dir, artifacts_dir)
          case compile_deps(deps, build_dir, [], [], proj_ffi_objs):
            result.Error(e) -> e
            result.Ok(#(dep_ifaces, dep_ssa, dep_objs, deps_rebuilt)) ->
              let src_dir = scanner.project_src_dir(project)
              let src_pairs = source_pairs_for_tests(src_dir, test_files)
              case pipeline.compile_named_file_list(
                src_pairs,
                artifacts_dir,
                dep_ifaces,
                deps_rebuilt
              ):
                result.Error(e) -> e
                result.Ok(#(src_ifaces, src_ssa, _, _)) ->
                  let scrub_dir = path.join(test_dir, "scrubbed")
                  let _ = files.mkdir(scrub_dir)
                  let scrubbed_ssa = scrub_main_from_ssa(src_ssa, scrub_dir, [])
                  let #(self_ifaces, self_ssa) = compile_self_alias(project, src_dir, test_dir, dep_ifaces)
                  let all_ifaces = list.append(dep_ifaces, list.append(src_ifaces, self_ifaces))
                  case compile_deps(dev_deps, build_dir, all_ifaces, [], []):
                    result.Error(e) -> e
                    result.Ok(#(dev_ifaces, dev_ssa, dev_objs, _)) ->
                      let all_ifaces2 = list.append(all_ifaces, dev_ifaces)
                      let test_art = path.join(test_dir, "artifacts")
                      let _ = files.mkdir(test_art)
                      case pipeline.compile_file_list(
                        test_files,
                        "test",
                        test_art,
                        all_ifaces2
                      ):
                        result.Error(e) -> e
                        result.Ok(#(test_ifaces, test_ssa, _, _)) ->
                          let all_ifaces3 = list.append(all_ifaces2, test_ifaces)
                          case pipeline.compile_module(
                            runner_path,
                            "test_runner",
                            test_dir,
                            all_ifaces3,
                            False
                          ):
                            result.Error(e) -> e
                            result.Ok(#(_, runner_ssa, _, _)) ->
                              let all_ssa = list.append(
                                dep_ssa,
                                list.append(
                                  scrubbed_ssa,
                                  list.append(
                                    self_ssa,
                                    list.append(
                                      dev_ssa,
                                      list.append(
                                        list.reverse(test_ssa),
                                        [runner_ssa]
                                      )
                                    )
                                  )
                                )
                              )
                              case pipeline.qbe_available():
                                False -> qbe_missing_error()
                                True ->
                                  case pipeline.c_compiler_available():
                                    False -> c_compiler_missing_error()
                                    True ->
                                      case pipeline.run_qbe_all_checked(all_ssa):
                                        result.Error(e) -> e
                                        result.Ok(s_files) ->
                                          let out_path = path.join(
                                            test_dir,
                                            "donna_test_runner"
                                          )
                                          let link_inputs = list.append(
                                            s_files,
                                            list.append(dep_objs, dev_objs)
                                          )
                                          let link_args = list.append(
                                            link_inputs,
                                            list.append(
                                              linker_flags(),
                                              ["-o", out_path]
                                            )
                                          )
                                          case output_current(out_path, link_inputs):
                                            True -> run_test_binary(out_path)
                                            False ->
                                              let link_log = out_path <> ".link.log"
                                              let link_cmd = pipeline.c_command(link_args)
                                              let link_code = shell.run(
                                                link_cmd <> " > " <> sh_quote(link_log) <> " 2>&1"
                                              )
                                              case link_code == 0:
                                                False ->
                                                  linker_failed_error(link_log, link_cmd)
                                                True ->
                                                  let _ = files.delete(link_log)
                                                  let _ = maybe_codesign(out_path)
                                                  run_test_binary(out_path)

fn invalid_test_names_error(names: List(String)) -> String:
  colors.red("error") <> ": invalid test function name\n" <> invalid_test_lines(names, "")

fn invalid_test_lines(names: List(String), acc: String) -> String:
  case names:
    [] ->
      acc <> colors.dim("  hint: public test functions must end with `_test`")
    [name, ..rest] ->
      invalid_test_lines(rest, acc <> "  " <> colors.path(name) <> "\n")

fn no_tests_error() -> String:
  colors.red("error") <> ": no test functions found\n" <> colors.dim("  hint: add a public function named like `example_test` in test/")

fn qbe_missing_error() -> String:
  let hint = colors.dim("  hint: install QBE and make sure qbe is in PATH")
  colors.red("error") <> ": qbe not found\n" <> hint

fn c_compiler_missing_error() -> String:
  let hint = colors.dim("  hint: install clang/gcc or Zig, or set DONNA_CC")
  colors.red("error") <> ": C compiler not found\n" <> hint

fn linker_failed_error(log_path: String, command: String) -> String:
  let output = string.trim(files.read(log_path))
  let header = colors.error_header("error") <> colors.bold(": linker failed")
  let command_row = colors.dim("  command: ") <> colors.path(command)
  let output_row = case string.is_empty(output):
    True -> colors.dim("  linker did not print an error message")
    False -> colors.dim("  linker output:\n") <> indent(output)
  let hint = colors.orange("hint:") <> " check missing C symbols, FFI objects, or linker flags"
  string.join([header, command_row, output_row, hint], "\n")

fn indent(text: String) -> String:
  indent_lines(string.split(text, "\n"), "")

fn indent_lines(lines: List(String), acc: String) -> String:
  case lines:
    [] -> acc
    [line, ..rest] -> indent_lines(rest, acc <> "    " <> line <> "\n")

fn normalize_dev_deps(
  project: scanner.Project,
  deps: List(dependencies.Dep)
) -> List(dependencies.Dep):
  case string.equal(scanner.project_name(project), "donna_stdlib"):
    False -> deps
    True -> remove_dep_named(deps, "donna", [])

fn remove_dep_named(
  deps: List(dependencies.Dep),
  name: String,
  acc: List(dependencies.Dep)
) -> List(dependencies.Dep):
  case deps:
    [] -> list.reverse(acc)
    [dep, ..rest] ->
      case string.equal(dependencies.dep_name(dep), name):
        True -> remove_dep_named(rest, name, acc)
        False -> remove_dep_named(rest, name, [dep, ..acc])

fn select_test_files(
  paths: List(String),
  selected: List(#(String, List(String)))
) -> List(String):
  select_test_files_loop(paths, selected, [])

fn select_test_files_loop(
  paths: List(String),
  selected: List(#(String, List(String))),
  acc: List(String)
) -> List(String):
  case paths:
    [] -> list.reverse(acc)
    [path, ..rest] ->
      let stem = path.drop_extension(path.basename(path))
      case selected_has_module(selected, stem):
        True -> select_test_files_loop(rest, selected, [path, ..acc])
        False -> select_test_files_loop(rest, selected, acc)

fn selected_has_module(
  selected: List(#(String, List(String))),
  stem: String
) -> Bool:
  case selected:
    [] -> False
    [#(name, _), ..rest] ->
      case string.equal(name, stem):
        True -> True
        False -> selected_has_module(rest, stem)

fn source_pairs_for_tests(
  src_dir: String,
  test_files: List(String)
) -> List(#(String, String)):
  let all_pairs = collect_source_pairs(src_dir, "", [])
  let all_names = pair_names(all_pairs, [])
  let seeds = test_imports(test_files, all_names, [])
  let needed = expand_needed_modules(seeds, all_pairs, all_names, [])
  filter_pairs_by_names(all_pairs, needed, [])

fn collect_source_pairs(
  dir: String,
  prefix: String,
  acc: List(#(String, String))
) -> List(#(String, String)):
  collect_source_pairs_loop(files.list_dir(dir), dir, prefix, acc)

fn collect_source_pairs_loop(
  entries: List(String),
  dir: String,
  prefix: String,
  acc: List(#(String, String))
) -> List(#(String, String)):
  case entries:
    [] -> list.reverse(acc)
    [name, ..rest] ->
      let path = path.join(dir, name)
      case string.ends_with(name, ".donna"):
        True ->
          let stem = path.drop_extension(name)
          let mod_name = case string.is_empty(prefix):
            True -> stem
            False -> prefix <> "/" <> stem
          collect_source_pairs_loop(
            rest,
            dir,
            prefix,
            [#(path, mod_name), ..acc]
          )
        False ->
          case files.is_dir(path):
            False -> collect_source_pairs_loop(rest, dir, prefix, acc)
            True ->
              let sub_prefix = case string.is_empty(prefix):
                True -> name
                False -> prefix <> "/" <> name
              let sub_pairs = collect_source_pairs(path, sub_prefix, [])
              collect_source_pairs_loop(
                rest,
                dir,
                prefix,
                list.append(list.reverse(sub_pairs), acc)
              )

fn pair_names(
  pairs: List(#(String, String)),
  acc: List(String)
) -> List(String):
  case pairs:
    [] -> list.reverse(acc)
    [#(_, name), ..rest] -> pair_names(rest, [name, ..acc])

fn test_imports(
  paths: List(String),
  all_names: List(String),
  acc: List(String)
) -> List(String):
  case paths:
    [] -> acc
    [path, ..rest] ->
      let imps = import_lines(files.read(path), all_names, acc)
      test_imports(rest, all_names, imps)

fn import_lines(
  src: String,
  all_names: List(String),
  acc: List(String)
) -> List(String):
  import_line_loop(string.split(src, "\n"), all_names, acc)

fn import_line_loop(
  lines: List(String),
  all_names: List(String),
  acc: List(String)
) -> List(String):
  case lines:
    [] -> acc
    [line, ..rest] ->
      case string.starts_with(line, "import "):
        False -> import_line_loop(rest, all_names, acc)
        True ->
          let raw = string.slice(line, 7, string.length(line) - 7)
          let dep = local_dep_name(import_path_only(raw), all_names)
          case string.is_empty(dep) || list.contains_str(acc, dep):
            True -> import_line_loop(rest, all_names, acc)
            False -> import_line_loop(rest, all_names, [dep, ..acc])

fn expand_needed_modules(
  pending: List(String),
  pairs: List(#(String, String)),
  all_names: List(String),
  seen: List(String)
) -> List(String):
  case pending:
    [] -> seen
    [name, ..rest] ->
      case list.contains_str(seen, name):
        True -> expand_needed_modules(rest, pairs, all_names, seen)
        False ->
          let path = path_for_module(pairs, name)
          let deps = import_lines(files.read(path), all_names, [])
          expand_needed_modules(
            list.append(deps, rest),
            pairs,
            all_names,
            [name, ..seen]
          )

fn path_for_module(pairs: List(#(String, String)), name: String) -> String:
  case pairs:
    [] -> ""
    [#(path, mod_name), ..rest] ->
      case string.equal(mod_name, name):
        True -> path
        False -> path_for_module(rest, name)

fn filter_pairs_by_names(
  pairs: List(#(String, String)),
  names: List(String),
  acc: List(#(String, String))
) -> List(#(String, String)):
  case pairs:
    [] -> list.reverse(acc)
    [#(path, name), ..rest] ->
      case list.contains_str(names, name):
        True -> filter_pairs_by_names(rest, names, [#(path, name), ..acc])
        False -> filter_pairs_by_names(rest, names, acc)

fn import_path_only(raw: String) -> String:
  let trimmed = string.trim(raw)
  let parts = string.split(trimmed, " as ")
  case parts:
    [] -> trimmed
    [path, .._] -> string.trim(path)

fn local_dep_name(imp: String, all_names: List(String)) -> String:
  case list.contains_str(all_names, imp):
    True -> imp
    False ->
      let last = path_last_segment(imp)
      find_local_dep_by_last_segment(all_names, last)

fn find_local_dep_by_last_segment(names: List(String), last: String) -> String:
  case names:
    [] -> ""
    [name, ..rest] ->
      case string.equal(path_last_segment(name), last):
        True -> name
        False -> find_local_dep_by_last_segment(rest, last)

fn path_last_segment(path: String) -> String:
  path_last_segment_loop(string.split(path, "/"), "")

fn path_last_segment_loop(parts: List(String), last: String) -> String:
  case parts:
    [] -> last
    [part, ..rest] -> path_last_segment_loop(rest, part)

fn compile_self_alias(
  project: scanner.Project,
  src_dir: String,
  test_dir: String,
  dep_ifaces: List(#(String, typed_ast.ModuleInterface))
) -> #(List(#(String, typed_ast.ModuleInterface)), List(String)):
  case string.equal(scanner.project_name(project), "donna_stdlib"):
    False -> #([], [])
    True ->
      let alias_art = path.join(test_dir, "self_alias_artifacts")
      let _ = files.mkdir(alias_art)
      case pipeline.compile_dir(src_dir, "donna", alias_art, dep_ifaces, False):
        result.Error(_) -> #([], [])
        result.Ok(#(ifaces, ssa, _, _)) -> #(ifaces, ssa)

fn compile_deps(
  deps: List(dependencies.Dep),
  build_dir: String,
  iface_acc: List(#(String, typed_ast.ModuleInterface)),
  ssa_acc: List(String),
  obj_acc: List(String)
) -> result.Result(#(List(#(String, typed_ast.ModuleInterface)), List(String), List(String), Bool), String):
  case deps:
    [] -> result.Ok(#(iface_acc, ssa_acc, obj_acc, False))
    [dep, ..rest] ->
      let pkg_dir = path.join(path.join(build_dir, "packages"), dependencies.dep_name(dep))
      let art_dir = path.join(pkg_dir, "artifacts")
      let _ = files.mkdir(path.join(build_dir, "packages"))
      let _ = files.mkdir(pkg_dir)
      let _ = files.mkdir(art_dir)
      let src_dir = dependencies.dep_src_dir(dep)
      case pipeline.compile_dir(
        src_dir,
        dependencies.dep_name(dep),
        art_dir,
        iface_acc,
        False
      ):
        result.Error(e) -> result.Error(e)
        result.Ok(#(new_ifaces, new_ssa, rebuilt, _)) ->
          let new_objs = pipeline.compile_ffi(dependencies.dep_path(dep), art_dir)
          let next_ifaces = list.append(iface_acc, new_ifaces)
          let next_ssa = list.append(ssa_acc, new_ssa)
          let next_objs = list.append(obj_acc, new_objs)
          case compile_deps(rest, build_dir, next_ifaces, next_ssa, next_objs):
            result.Error(e) -> result.Error(e)
            result.Ok(#(ifaces2, ssa2, objs2, rest_rebuilt)) ->
              let any_rebuilt = case rebuilt:
                True -> True
                False -> rest_rebuilt
              result.Ok(#(ifaces2, ssa2, objs2, any_rebuilt))

fn find_donna_files(dir: String) -> List(String):
  collect_donna(files.list_dir(dir), dir, [])

fn collect_donna(
  entries: List(String),
  dir: String,
  acc: List(String)
) -> List(String):
  case entries:
    [] -> list.reverse(acc)
    [name, ..rest] ->
      case string.ends_with(name, ".donna"):
        True -> collect_donna(rest, dir, [path.join(dir, name), ..acc])
        False -> collect_donna(rest, dir, acc)

fn parse_test_args(args: List(#(String, String))) -> #(String, List(String)):
  let pos = argparse.positional(args)
  let only = argparse.get(args, "only")
  case pos:
    [] -> #(".", filter_values([only], []))
    [first, ..rest] ->
      case files.is_dir(first):
        True -> #(first, filter_values([only, ..rest], []))
        False -> #(".", filter_values([only, ..pos], []))

fn filter_values(values: List(String), acc: List(String)) -> List(String):
  case values:
    [] -> list.reverse(acc)
    [value, ..rest] ->
      case string.is_empty(value):
        True -> filter_values(rest, acc)
        False -> filter_values(rest, [value, ..acc])

fn linker_flags() -> List(String):
  case shell.run("uname | grep -q '^Darwin$' >/dev/null 2>&1") == 0:
    True -> ["-Wl,-stack_size,0x2000000"]
    False -> ["-lm"]

fn maybe_codesign(path: String) -> Int:
  case shell.run("uname | grep -q '^Darwin$' >/dev/null 2>&1") == 0:
    False -> 0
    True ->
      shell.run(
        "command -v codesign >/dev/null 2>&1 && codesign --force -s - " <> path <> " >/dev/null 2>&1"
      )

fn run_test_binary(out_path: String) -> String:
  let _ = logger.running_tests()
  let _ = shell.flush()
  let code = shell.exec(out_path, [])
  case code == 0:
    True -> ""
    False ->
      let _ = process_exit(code)
      ""

fn output_current(output: String, inputs: List(String)) -> Bool:
  case files.exists(output):
    False -> False
    True -> inputs_older_than_output(inputs, output)

fn inputs_older_than_output(inputs: List(String), output: String) -> Bool:
  case inputs:
    [] -> True
    [input, ..rest] ->
      case shell.run("test " <> sh_quote(input) <> " -nt " <> sh_quote(output)) == 0:
        True -> False
        False -> inputs_older_than_output(rest, output)

fn sh_quote(s: String) -> String:
  "'" <> string.replace(s, "'", "'\\''") <> "'"

fn scrub_main_from_ssa(
  paths: List(String),
  scrub_dir: String,
  acc: List(String)
) -> List(String):
  case paths:
    [] -> list.reverse(acc)
    [p, ..rest] ->
      let src = files.read(p)
      let patched2 = case string.contains(src, "$main(") || string.contains(src, "$donna_program_main("):
        False -> src
        True ->
          let patched = string.replace(
            src,
            "export function w $main(",
            "function w $__proj_main("
          )
          string.replace(
            patched,
            "export function w $donna_program_main(",
            "function w $__proj_main("
          )
      let dst = path.join(scrub_dir, path.basename(p))
      let _ = write_if_changed(dst, patched2)
      scrub_main_from_ssa(rest, scrub_dir, [dst, ..acc])

fn write_if_changed(path: String, content: String) -> Int:
  case files.exists(path):
    False -> files.write(path, content)
    True ->
      case string.equal(files.read(path), content):
        True -> 0
        False -> files.write(path, content)
