//// `donna build` command.
//// Builds project dependencies, compiles source modules, invokes QBE, and links
//// application projects into `build/bin/`.

import donna/files
import donna/path
import donna/list
import donna/string
import donna/shell
import donna/result
import utilities/colors
import utilities/logger
import builder/scanner
import builder/pipeline
import builder/dependencies
import compiler/typesystem/typed_ast
import donna/time

/// Result of building a project and whether it produced an application binary.
pub type BuildOutcome:
  BuildOk(Bool)
  BuildFailed(String)

/// Build mode selected from `donna build` arguments.
pub type BuildConfig:
  BuildDebug
  BuildRelease(List(String))

/// Run the `donna build` command and return the text printed by the CLI.
pub fn run(args: List(#(String, String))) -> String:
  let dir = build_dir_arg(args)
  case build_config(args):
    result.Error(msg) -> msg
    result.Ok(config) ->
      case scanner.scan(dir):
        scanner.ScanErr(msg) ->
          colors.red("error") <> ": " <> msg
        scanner.ScanOk(project) ->
          case build_project_with_config(dir, project, config):
            BuildFailed(msg) -> msg
            BuildOk(_) -> ""

/// Build a scanned project.
///
/// Library projects are considered successful even when they do not have a
/// public `main`; application projects continue through QBE and the system C
/// linker to produce an executable in `build/bin/`.
pub fn build_project(dir: String, project: scanner.Project) -> BuildOutcome:
  build_project_with_config(dir, project, BuildDebug)

/// Build a project with an explicit build config.
pub fn build_project_with_config(
  dir: String,
  project: scanner.Project,
  config: BuildConfig
) -> BuildOutcome:
  case config:
    BuildDebug -> build_project_target(dir, project, "", "debug")
    BuildRelease(targets) -> build_release_targets(dir, project, targets)

fn build_release_targets(
  dir: String,
  project: scanner.Project,
  targets: List(String)
) -> BuildOutcome:
  case targets:
    [] -> BuildOk(False)
    [target, ..rest] ->
      case build_project_target(dir, project, target, "release"):
        BuildFailed(msg) -> BuildFailed(msg)
        BuildOk(has_main) ->
          case build_release_targets(dir, project, rest):
            BuildFailed(msg) -> BuildFailed(msg)
            BuildOk(rest_has_main) ->
              case has_main:
                True -> BuildOk(True)
                False -> BuildOk(rest_has_main)

fn build_project_target(
  dir: String,
  project: scanner.Project,
  qbe_target: String,
  mode: String
) -> BuildOutcome:
  let t0 = time.now_us()
  let build_dir = scanner.project_build_dir(project)
  let target_root = target_root_dir(project, mode, qbe_target)
  let bin_dir = bin_dir_for_mode(project, mode, qbe_target)
  let artifacts_dir = artifacts_dir_for_mode(project, mode, qbe_target)
  let deps_build_dir = deps_build_dir_for_mode(project, mode, qbe_target)
  let _ = files.mkdir(build_dir)
  let _ = mkdir_release_parents(project, mode)
  let _ = files.mkdir(target_root)
  let _ = files.mkdir(bin_dir)
  let _ = files.mkdir(artifacts_dir)
  let toml_path = path.join(dir, "donna.toml")
  case dependencies.resolve_deps_checked(toml_path, dir):
    result.Error(e) -> BuildFailed(e)
    result.Ok(all_deps) ->
      let proj_ffi_objs = compile_ffi_for_mode(dir, artifacts_dir, mode, qbe_target)
      case compile_deps(
        all_deps,
        deps_build_dir,
        [],
        [],
        proj_ffi_objs,
        mode,
        qbe_target
      ):
        result.Error(e) -> BuildFailed(e)
        result.Ok(#(dep_ifaces, dep_ssa, dep_objs, deps_rebuilt)) ->
          let src_dir = scanner.project_src_dir(project)
          case pipeline.compile_dir(src_dir, "", artifacts_dir, dep_ifaces, deps_rebuilt):
            result.Error(e) -> BuildFailed(e)
            result.Ok(#(src_ifaces, src_ssa, _, src_warn_count)) ->
              case has_public_main(src_ifaces):
                False ->
                  let out_path = path.join(bin_dir, scanner.project_name(project))
                  let _ = files.delete(out_path)
                  let _ = logger.ok("", time.now_us() - t0)
                  let _ = logger.summary(0, src_warn_count)
                  BuildOk(False)
                True ->
                  let all_ssa = list.append(dep_ssa, src_ssa)
                  case pipeline.qbe_available():
                    False -> BuildFailed(qbe_missing_error())
                    True ->
                      case c_compiler_available_for_mode(mode):
                        False -> BuildFailed(c_compiler_missing_error())
                        True ->
                          case run_qbe_for_mode(all_ssa, mode, qbe_target):
                            result.Error(e) -> BuildFailed(e)
                            result.Ok(s_files) ->
                              let name = output_name_for_target(
                                scanner.project_name(project),
                                qbe_target
                              )
                              let out_path = path.join(bin_dir, name)
                              let link_args = list.append(
                                s_files,
                                list.append(
                                  dep_objs,
                                  list.append(
                                    cc_flags_for_mode(mode, qbe_target),
                                    list.append(
                                      linker_flags_for_mode(mode, qbe_target),
                                      ["-o", out_path]
                                    )
                                  )
                                )
                              )
                              let link_log = out_path <> ".link.log"
                              let link_cmd = c_command_for_mode(mode, link_args)
                              let link_code = shell.run(
                                link_cmd <> " > " <> sh_quote(link_log) <> " 2>&1"
                              )
                              case link_code == 0:
                                False ->
                                  BuildFailed(linker_failed_error(link_log, link_cmd))
                                True ->
                                  let _ = files.delete(link_log)
                                  let _ = maybe_codesign(out_path)
                                  let _ = logger.ok("", time.now_us() - t0)
                                  let _ = logger.summary(0, src_warn_count)
                                  BuildOk(True)

fn target_root_dir(
  project: scanner.Project,
  mode: String,
  qbe_target: String
) -> String:
  case string.equal(mode, "release"):
    False -> scanner.project_dev_dir(project)
    True ->
      path.join(
        path.join(
          path.join(scanner.project_build_dir(project), "release"),
          "target"
        ),
        release_target_dir(qbe_target)
      )

fn bin_dir_for_mode(
  project: scanner.Project,
  mode: String,
  qbe_target: String
) -> String:
  case string.equal(mode, "release"):
    False -> scanner.project_bin_dir(project)
    True -> path.join(target_root_dir(project, mode, qbe_target), "bin")

fn artifacts_dir_for_mode(
  project: scanner.Project,
  mode: String,
  qbe_target: String
) -> String:
  case string.equal(mode, "release"):
    False -> scanner.project_dev_artifacts_dir(project)
    True -> path.join(target_root_dir(project, mode, qbe_target), "artifacts")

fn deps_build_dir_for_mode(
  project: scanner.Project,
  mode: String,
  qbe_target: String
) -> String:
  case string.equal(mode, "release"):
    False -> scanner.project_build_dir(project)
    True -> target_root_dir(project, mode, qbe_target)

fn mkdir_release_parents(project: scanner.Project, mode: String) -> Int:
  case string.equal(mode, "release"):
    False -> 0
    True ->
      let release_dir = path.join(scanner.project_build_dir(project), "release")
      let target_dir = path.join(release_dir, "target")
      let _ = files.mkdir(release_dir)
      files.mkdir(target_dir)

fn compile_ffi_for_mode(
  dir: String,
  artifacts_dir: String,
  mode: String,
  qbe_target: String
) -> List(String):
  case string.equal(mode, "release"):
    True -> pipeline.compile_ffi_target(dir, artifacts_dir, qbe_target)
    False -> pipeline.compile_ffi(dir, artifacts_dir)

fn run_qbe_for_mode(
  all_ssa: List(String),
  mode: String,
  qbe_target: String
) -> result.Result(List(String), String):
  case string.equal(mode, "release"):
    True -> pipeline.run_qbe_all_checked_target(all_ssa, qbe_target)
    False -> pipeline.run_qbe_all_checked(all_ssa)

fn c_compiler_available_for_mode(mode: String) -> Bool:
  case string.equal(mode, "release"):
    True -> pipeline.release_c_compiler_available()
    False -> pipeline.c_compiler_available()

fn c_command_for_mode(mode: String, args: List(String)) -> String:
  case string.equal(mode, "release"):
    True -> pipeline.release_c_command(args)
    False -> pipeline.c_command(args)

fn qbe_missing_error() -> String:
  let hint = colors.dim("  hint: install QBE and make sure qbe is in PATH")
  colors.red("error") <> ": qbe not found\n" <> hint

fn c_compiler_missing_error() -> String:
  let hint = colors.dim("  hint: install clang/gcc or Zig, or set DONNA_CC")
  colors.red("error") <> ": C compiler not found\n" <> hint

fn linker_failed_error(log_path: String, command: String) -> String:
  let output = string.trim(files.read(log_path))
  let header = colors.error_header("error") <> colors.bold(": linker failed")
  let command_row = colors.dim("  command: ") <> colors.path(command)
  let output_row = case string.is_empty(output):
    True -> colors.dim("  linker did not print an error message")
    False -> colors.dim("  linker output:\n") <> indent(output)
  let hint = colors.orange("hint:") <> " check missing C symbols, FFI objects, or linker flags"
  string.join([header, command_row, output_row, hint], "\n")

fn indent(text: String) -> String:
  indent_lines(string.split(text, "\n"), "")

fn indent_lines(lines: List(String), acc: String) -> String:
  case lines:
    [] -> acc
    [line, ..rest] -> indent_lines(rest, acc <> "    " <> line <> "\n")

fn compile_deps(
  deps: List(dependencies.Dep),
  build_dir: String,
  iface_acc: List(#(String, typed_ast.ModuleInterface)),
  ssa_acc: List(String),
  obj_acc: List(String),
  mode: String,
  qbe_target: String
) -> result.Result(#(List(#(String, typed_ast.ModuleInterface)), List(String), List(String), Bool), String):
  case deps:
    [] -> result.Ok(#(iface_acc, ssa_acc, obj_acc, False))
    [dep, ..rest] ->
      let pkg_dir = path.join(path.join(build_dir, "packages"), dependencies.dep_name(dep))
      let art_dir = path.join(pkg_dir, "artifacts")
      let _ = files.mkdir(path.join(build_dir, "packages"))
      let _ = files.mkdir(pkg_dir)
      let _ = files.mkdir(art_dir)
      let src_dir = dependencies.dep_src_dir(dep)
      case pipeline.compile_dir(
        src_dir,
        dependencies.dep_name(dep),
        art_dir,
        iface_acc,
        False
      ):
        result.Error(e) -> result.Error(e)
        result.Ok(#(new_ifaces, new_ssa, rebuilt, _)) ->
          let new_objs = compile_ffi_for_mode(
            dependencies.dep_path(dep),
            art_dir,
            mode,
            qbe_target
          )
          let next_ifaces = list.append(iface_acc, new_ifaces)
          let next_ssa = list.append(ssa_acc, new_ssa)
          let next_objs = list.append(obj_acc, new_objs)
          case compile_deps(
            rest,
            build_dir,
            next_ifaces,
            next_ssa,
            next_objs,
            mode,
            qbe_target
          ):
            result.Error(e) -> result.Error(e)
            result.Ok(#(ifaces2, ssa2, objs2, rest_rebuilt)) ->
              let any_rebuilt = case rebuilt:
                True -> True
                False -> rest_rebuilt
              result.Ok(#(ifaces2, ssa2, objs2, any_rebuilt))

fn has_public_main(ifaces: List(#(String, typed_ast.ModuleInterface))) -> Bool:
  case ifaces:
    [] -> False
    [#(_, iface), ..rest] ->
      case iface_has_main(iface):
        True -> True
        False -> has_public_main(rest)

fn iface_has_main(iface: typed_ast.ModuleInterface) -> Bool:
  case iface:
    typed_ast.ModuleInterface(bindings, _) -> bindings_have_main(bindings)

fn bindings_have_main(bindings: List(#(String, types.Type))) -> Bool:
  case bindings:
    [] -> False
    [#(name, _), ..rest] ->
      case string.equal(name, "main"):
        True -> True
        False -> bindings_have_main(rest)

fn linker_flags() -> List(String):
  case shell.run("uname | grep -q '^Darwin$' >/dev/null 2>&1") == 0:
    True -> ["-Wl,-stack_size,0x2000000"]
    False -> ["-lm"]

fn linker_flags_for_mode(mode: String, qbe_target: String) -> List(String):
  case string.equal(mode, "release"):
    False -> linker_flags()
    True -> release_linker_flags(qbe_target)

fn release_linker_flags(qbe_target: String) -> List(String):
  case qbe_target:
    "amd64_apple" -> ["-Wl,-stack_size,0x2000000"]
    "arm64_apple" -> ["-Wl,-stack_size,0x2000000"]
    "amd64_win" -> []
    _ -> ["-lm"]

fn cc_flags_for_mode(mode: String, qbe_target: String) -> List(String):
  case string.equal(mode, "release"):
    False -> []
    True -> list.append(["-O2"], pipeline.release_cc_target_flags(qbe_target))

fn output_name_for_target(name: String, qbe_target: String) -> String:
  case string.equal(qbe_target, "amd64_win"):
    True -> name <> ".exe"
    False -> name

fn maybe_codesign(path: String) -> Int:
  case shell.run("uname | grep -q '^Darwin$' >/dev/null 2>&1") == 0:
    False -> 0
    True ->
      shell.run(
        "command -v codesign >/dev/null 2>&1 && codesign --force -s - " <> path <> " >/dev/null 2>&1"
      )

fn sh_quote(s: String) -> String:
  "'" <> string.replace(s, "'", "'\\''") <> "'"

fn first_positional(args: List(#(String, String))) -> String:
  case args:
    [] -> "."
    [#("", v), .._] -> v
    [_, ..rest] -> first_positional(rest)

fn build_dir_arg(args: List(#(String, String))) -> String:
  let positional = first_positional(args)
  case string.equal(positional, "."):
    False -> positional
    True ->
      let release_value = flag_value(args, "release")
      case string.equal(release_value, "true"):
        True -> "."
        False ->
          case string.is_empty(release_value):
            True -> "."
            False -> release_value

fn build_config(
  args: List(#(String, String))
) -> result.Result(BuildConfig, String):
  case has_flag(args, "release"):
    False -> result.Ok(BuildDebug)
    True ->
      let target = flag_value(args, "target")
      case string.equal(target, "all"):
        True -> result.Ok(BuildRelease(all_release_targets()))
        False ->
          case normalize_release_target(target):
            result.Error(msg) -> result.Error(msg)
            result.Ok(t) -> result.Ok(BuildRelease([t]))

fn has_flag(args: List(#(String, String)), key: String) -> Bool:
  case args:
    [] -> False
    [#(k, _), ..rest] ->
      case string.equal(k, key):
        True -> True
        False -> has_flag(rest, key)

fn flag_value(args: List(#(String, String)), key: String) -> String:
  case args:
    [] -> ""
    [#(k, v), ..rest] ->
      case string.equal(k, key):
        True -> v
        False -> flag_value(rest, key)

/// Normalize a user-facing release target to QBE's target name.
pub fn normalize_release_target(
  target: String
) -> result.Result(String, String):
  let t = case string.is_empty(target):
    True -> host_release_target()
    False -> target
  case t:
    "amd64" -> result.Ok("amd64_sysv")
    "x86_64" -> result.Ok("amd64_sysv")
    "amd64_sysv" -> result.Ok("amd64_sysv")
    "amd64_apple" -> result.Ok("amd64_apple")
    "x86_64_apple" -> result.Ok("amd64_apple")
    "amd64_win" -> result.Ok("amd64_win")
    "x86_64_win" -> result.Ok("amd64_win")
    "arm64" -> result.Ok("arm64")
    "aarch64" -> result.Ok("arm64")
    "arm64_apple" -> result.Ok("arm64_apple")
    "aarch64_apple" -> result.Ok("arm64_apple")
    _ ->
      result.Error(
        colors.red("error") <> ": unknown release target " <> colors.path(target)
      )

/// Return all QBE targets Donna release builds currently support.
pub fn all_release_targets() -> List(String):
  ["amd64_sysv", "amd64_apple", "amd64_win", "arm64", "arm64_apple"]

fn host_release_target() -> String:
  case shell.run("uname | grep -q '^Darwin$' >/dev/null 2>&1") == 0:
    True ->
      case shell.run("uname -m | grep -q 'arm64\\|aarch64' >/dev/null 2>&1") == 0:
        True -> "arm64_apple"
        False -> "amd64_apple"
    False ->
      case shell.run("uname -m | grep -q 'arm64\\|aarch64' >/dev/null 2>&1") == 0:
        True -> "arm64"
        False -> "amd64_sysv"

/// Return the directory name used inside `build/release/target/`.
pub fn release_target_dir(qbe_target: String) -> String:
  case qbe_target:
    "amd64_sysv" -> "amd64"
    _ -> qbe_target
