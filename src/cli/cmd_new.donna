//// `donna new` command.
//// Creates a new Donna project with source, test, README, gitignore, stdlib,
//// and unittest dependency defaults.

import utilities/colors
import donna/files
import donna/path
import donna/string

/// Run `donna new` and create a project scaffold.
pub fn run(args: List(#(String, String))) -> String:
  case first_positional(args):
    "" ->
      colors.red("error") <> ": donna new requires a project name\n" <> colors.dim("  Usage: donna new <name>")
    name ->
      case files.exists(name):
        True ->
          colors.red("error") <> ": directory " <> colors.path(name) <> " already exists"
        False ->
          create_project(name)

fn create_project(path: String) -> String:
  let name = path.basename(path)
  files.mkdir(path)
  files.mkdir(path <> "/src")
  files.mkdir(path <> "/test")
  files.mkdir(path <> "/.github")
  files.mkdir(path <> "/.github/workflows")
  files.write(path <> "/donna.toml", toml_content(name))
  files.write(path <> "/src/" <> name <> ".donna", main_content(name))
  files.write(path <> "/test/" <> name <> "_test.donna", test_content(name))
  files.write(path <> "/.github/workflows/test.yml", workflow_content())
  files.write(path <> "/README.md", readme_content(name))
  files.write(path <> "/.gitignore", gitignore_content())
  success_message(name)

fn success_message(name: String) -> String:
  let line1 = "Your Donna project " <> name <> " has been successfully created."
  let line2 = "The project can be compiled and tested by running these commands:"
  let cmd1 = colors.dim("\tcd " <> name)
  let cmd2 = colors.dim("\tdonna test")
  string.join([line1, line2, "", cmd1, cmd2, ""], "\n")

fn toml_content(name: String) -> String:
  "name = \"" <> name <> "\"\nversion = \"0.1.0\"\n# description = \"\"\n# authors = [\"Your Name <you@example.com>\"]\n# licences = [\"MIT\"]\n# repository = { type = \"github\", user = \"\", repo = \"\" }\n# links = [{ title = \"Website\", href = \"\" }]\n\n[dependencies]\ndonna = { git = \"https://github.com/donna-lang/donna_stdlib\", version = \">=0.3.1 and <1.0.0\" }\n\n[dev-dependencies]\nunittest = { git = \"https://github.com/donna-lang/unittest\", version = \">=0.2.0 and <1.0.0\" }\n"

fn main_content(name: String) -> String:
  "import donna/io\n\n// " <> name <> " entry point\npub fn main() -> Nil:\n  io.println(\"Hello from " <> name <> "\")\n"

fn test_content(name: String) -> String:
  "import " <> name <> "\nimport unittest/should\n\npub fn smoke_test() -> String:\n  should.pass()\n"

fn workflow_content() -> String:
  "name: Test\n\non:\n  push:\n  pull_request:\n\njobs:\n  test:\n    runs-on: ubuntu-latest\n\n    steps:\n      - uses: actions/checkout@v4\n\n      - name: Cache QBE\n        uses: actions/cache@v4\n        with:\n          path: ~/.local/bin/qbe\n          key: qbe-${{ runner.os }}-2026-05-13\n\n      - name: Install QBE\n        shell: bash\n        run: |\n          set -euo pipefail\n          mkdir -p \"$HOME/.local/bin\"\n          export PATH=\"$HOME/.local/bin:$PATH\"\n          echo \"$HOME/.local/bin\" >> \"$GITHUB_PATH\"\n          if command -v qbe >/dev/null 2>&1; then\n            qbe --version || true\n            exit 0\n          fi\n          sudo apt-get update\n          if apt-cache show qbe >/dev/null 2>&1; then\n            sudo apt-get install -y qbe\n          elif [ -x \"$HOME/.local/bin/qbe\" ]; then\n            true\n          else\n            sudo apt-get install -y build-essential git make\n            git clone git://c9x.me/qbe.git \"$RUNNER_TEMP/qbe\"\n            make -C \"$RUNNER_TEMP/qbe\"\n            make -C \"$RUNNER_TEMP/qbe\" PREFIX=\"$HOME/.local\" install\n          fi\n          qbe --version || true\n\n      - name: Install Donna\n        shell: bash\n        run: |\n          set -euo pipefail\n          api=\"https://api.github.com/repos/donna-lang/donna/releases/latest\"\n          url=$(curl -fsSL \"$api\" | grep browser_download_url | grep -E 'linux.*(x86_64|amd64).*\\.(tar\\.gz|tgz|zip)' | head -n 1 | cut -d '\"' -f 4)\n          if [ -z \"$url\" ]; then\n            echo \"Could not find a Linux x86_64 Donna release artifact in donna-lang/donna\" >&2\n            exit 1\n          fi\n          mkdir -p \"$HOME/.donna/bin\" donna-release\n          curl -fsSL \"$url\" -o donna-release/archive\n          case \"$url\" in\n            *.zip) unzip -q donna-release/archive -d donna-release ;;\n            *) tar -xzf donna-release/archive -C donna-release ;;\n          esac\n          bin=$(find donna-release -type f -name donna -perm -111 | head -n 1)\n          if [ -z \"$bin\" ]; then\n            echo \"Donna binary not found in release artifact\" >&2\n            exit 1\n          fi\n          cp \"$bin\" \"$HOME/.donna/bin/donna\"\n          chmod +x \"$HOME/.donna/bin/donna\"\n          echo \"$HOME/.donna/bin\" >> \"$GITHUB_PATH\"\n\n      - name: Format\n        run: |\n          donna format\n          git diff --exit-code\n\n      - name: Check\n        run: donna check\n\n      - name: Test\n        run: donna test\n"

fn gitignore_content() -> String:
  "build/\n"

fn readme_content(name: String) -> String:
  "# " <> name <> "\n\n<a href=\"https://OWNER.github.io/REPO/\"><img src=\"https://img.shields.io/badge/Docs-Read-2F81F7?style=for-the-badge\" alt=\"Docs - Read\"/></a>\n<img src=\"https://img.shields.io/badge/Donna-" <> name <> "-FF6347?style=for-the-badge\" alt=\"Donna - " <> name <> "\"/>\n<img src=\"https://img.shields.io/github/actions/workflow/status/OWNER/REPO/test.yml?branch=main&label=Test&style=for-the-badge\" alt=\"Test status\"/>\n\n## Quick start\nClone the repository and cd into it.\nRun:\n```sh\ndonna build\ndonna test\ndonna run\n```\n"

fn first_positional(args: List(#(String, String))) -> String:
  case args:
    [] -> ""
    [#("", v), .._] -> v
    [_, ..rest] -> first_positional(rest)
