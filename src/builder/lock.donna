//// Lockfile parsing and rendering.
//// The lockfile records resolved dependency revisions so repeated builds use
//// the same package sources instead of floating on remote git branches.

import donna/files
import donna/list
import donna/string
import parsetoml/parsetoml

/// One package entry stored in `donna.lock`.
pub type LockedDep:
  LockedDep(name: String, git: String, rev: String)

/// Return the package name stored in a lockfile entry.
pub fn locked_name(d: LockedDep) -> String:
  case d:
    LockedDep(n, _, _) -> n

/// Return the git URL stored in a lockfile entry.
pub fn locked_git(d: LockedDep) -> String:
  case d:
    LockedDep(_, g, _) -> g

/// Return the resolved git revision stored in a lockfile entry.
pub fn locked_rev(d: LockedDep) -> String:
  case d:
    LockedDep(_, _, r) -> r

/// Read a `donna.lock` file into resolved dependency entries.
///
/// Missing or invalid lockfiles are treated as empty so dependency resolution
/// can continue and rewrite a fresh lockfile.
pub fn read(lock_path: String) -> List(LockedDep):
  case files.exists(lock_path):
    False -> []
    True ->
      let src = files.read(lock_path)
      let parsed = parsetoml.parse(src)
      case parsetoml.is_err(parsed):
        True -> []
        False ->
          let toml = parsetoml.unwrap_table(parsed)
          case parsetoml.get_table(toml, "packages"):
            parsetoml.Err(_) -> []
            parsetoml.Ok(pkgs) ->
              case pkgs:
                parsetoml.TomlTable(pairs) -> collect_locked(pairs, [])
                _ -> []

fn collect_locked(
  pairs: List(#(String, parsetoml.TomlValue)),
  acc: List(LockedDep)
) -> List(LockedDep):
  case pairs:
    [] -> list.reverse(acc)
    [#(name, value), ..rest] ->
      let g = opt_str(value, "git")
      let r = opt_str(value, "rev")
      case string.is_empty(g) || string.is_empty(r):
        True -> collect_locked(rest, acc)
        False -> collect_locked(rest, [LockedDep(name, g, r), ..acc])

/// Find the locked revision for a package name, or return `""` when absent.
pub fn find_rev(deps: List(LockedDep), name: String) -> String:
  case deps:
    [] -> ""
    [d, ..rest] ->
      case string.equal(locked_name(d), name):
        True -> locked_rev(d)
        False -> find_rev(rest, name)

/// Insert or replace one dependency entry while preserving the surrounding list.
pub fn upsert(deps: List(LockedDep), new_dep: LockedDep) -> List(LockedDep):
  upsert_loop(deps, new_dep, [])

fn upsert_loop(
  deps: List(LockedDep),
  new_dep: LockedDep,
  acc: List(LockedDep)
) -> List(LockedDep):
  case deps:
    [] -> list.reverse([new_dep, ..acc])
    [d, ..rest] ->
      case string.equal(locked_name(d), locked_name(new_dep)):
        True -> list.append(list.reverse(acc), [new_dep, ..rest])
        False -> upsert_loop(rest, new_dep, [d, ..acc])

/// Remove one dependency entry by package name.
pub fn remove(deps: List(LockedDep), name: String) -> List(LockedDep):
  remove_loop(deps, name, [])

fn remove_loop(
  deps: List(LockedDep),
  name: String,
  acc: List(LockedDep)
) -> List(LockedDep):
  case deps:
    [] -> list.reverse(acc)
    [d, ..rest] ->
      case string.equal(locked_name(d), name):
        True -> remove_loop(rest, name, acc)
        False -> remove_loop(rest, name, [d, ..acc])

/// Write lockfile entries to disk and return the write status.
pub fn write(lock_path: String, deps: List(LockedDep)) -> Int:
  files.write(lock_path, format_lock(deps))

fn format_lock(deps: List(LockedDep)) -> String:
  "# donna.lock — generated by donna build. Commit this file.\n\n" <> format_deps(deps, "")

fn format_deps(deps: List(LockedDep), acc: String) -> String:
  case deps:
    [] -> acc
    [d, ..rest] ->
      let header = "[packages." <> locked_name(d) <> "]\n"
      let git = "git = \"" <> locked_git(d) <> "\"\n"
      let rev = "rev = \"" <> locked_rev(d) <> "\"\n\n"
      let entry = header <> git <> rev
      format_deps(rest, acc <> entry)

/// Store the currently cached git revision beside a cloned dependency.
pub fn write_cached_rev(cache_path: String, rev: String) -> Int:
  files.write(files.join(cache_path, ".donna_rev"), rev)

/// Read the cached git revision marker for a cloned dependency.
pub fn read_cached_rev(cache_path: String) -> String:
  let marker = files.join(cache_path, ".donna_rev")
  case files.exists(marker):
    False -> ""
    True -> string.trim(files.read(marker))

fn opt_str(value: parsetoml.TomlValue, key: String) -> String:
  case parsetoml.get_string(value, key):
    parsetoml.Err(_) -> ""
    parsetoml.Ok(s) -> s
