//// Dependency resolution and package fetching.
//// This module reads dependency declarations from `donna.toml`, resolves git
//// revisions, keeps the lockfile in sync, and returns local package paths for
//// the build pipeline.

import donna/files
import donna/list
import donna/shell
import donna/string
import donna/result
import parsetoml/parsetoml
import utilities/colors
import utilities/logger
import builder/lock
import builder/semver

/// A resolved package dependency with its local checkout or path.
pub type Dep:
  Dep(name: String, path: String)

pub type ExpandResult:
  ExpandOk(deps: List(Dep), locked: List(lock.LockedDep), seen: List(String))
  ExpandErr(message: String)

/// Return the dependency name from a resolved dependency record.
pub fn dep_name(d: Dep) -> String:
  case d:
    Dep(n, _) -> n

/// Return the local filesystem path for a resolved dependency.
pub fn dep_path(d: Dep) -> String:
  case d:
    Dep(_, p) -> p

/// Return the dependency source directory.
pub fn dep_src_dir(d: Dep) -> String:
  files.join(dep_path(d), "src")

/// Return the dependency FFI directory.
pub fn dep_ffi_dir(d: Dep) -> String:
  files.join(dep_path(d), "ffi")

/// Resolve normal and dev dependencies from `donna.toml`.
///
/// The project lockfile is read before resolution and rewritten with any newly
/// resolved git revisions.
pub fn resolve_all(toml_path: String, project_dir: String) -> List(Dep):
  case resolve_all_checked(toml_path, project_dir):
    result.Ok(deps) -> deps
    result.Error(_) -> []

/// Resolve normal and dev dependencies and report dependency graph errors.
pub fn resolve_all_checked(
  toml_path: String,
  project_dir: String
) -> result.Result(List(Dep), String):
  let lock_path = files.join(project_dir, "donna.lock")
  let locked = lock.read(lock_path)
  let toml_src = files.read(toml_path)
  let root_name = package_name(toml_src, files.basename(project_dir))
  let root_id = package_identity(toml_src, project_dir)
  let root_ids = initial_identity_stack(root_id)
  let #(deps, locked1) = parse_section(toml_src, project_dir, "dependencies", locked)
  case expand_deps_checked(deps, locked1, [], [], root_ids, root_name, []):
    ExpandErr(e) -> result.Error(e)
    ExpandOk(runtime_deps, locked2, seen) ->
      let #(dev_deps, locked3) = parse_section(toml_src, project_dir, "dev-dependencies", locked2)
      case expand_deps_checked(dev_deps, locked3, seen, [], root_ids, root_name, []):
        ExpandErr(e) -> result.Error(e)
        ExpandOk(expanded_dev_deps, locked4, _) ->
          let _ = lock.write(lock_path, locked4)
          result.Ok(list.append(runtime_deps, expanded_dev_deps))

/// Resolve only `[dependencies]` from `donna.toml` and update the lockfile.
pub fn resolve_deps(toml_path: String, project_dir: String) -> List(Dep):
  case resolve_deps_checked(toml_path, project_dir):
    result.Ok(deps) -> deps
    result.Error(_) -> []

/// Resolve only `[dependencies]` and report dependency graph errors.
pub fn resolve_deps_checked(
  toml_path: String,
  project_dir: String
) -> result.Result(List(Dep), String):
  let lock_path = files.join(project_dir, "donna.lock")
  let locked = lock.read(lock_path)
  let toml_src = files.read(toml_path)
  let root_name = package_name(toml_src, files.basename(project_dir))
  let root_id = package_identity(toml_src, project_dir)
  let #(deps, locked1) = parse_section(toml_src, project_dir, "dependencies", locked)
  case expand_deps_checked(
    deps,
    locked1,
    [],
    [],
    initial_identity_stack(root_id),
    root_name,
    []
  ):
    ExpandErr(e) -> result.Error(e)
    ExpandOk(expanded, locked2, _) ->
      let _ = lock.write(lock_path, locked2)
      result.Ok(expanded)

/// Resolve only `[dev-dependencies]` from `donna.toml` and update the lockfile.
pub fn resolve_dev_deps(toml_path: String, project_dir: String) -> List(Dep):
  case resolve_dev_deps_checked(toml_path, project_dir):
    result.Ok(deps) -> deps
    result.Error(_) -> []

/// Resolve only `[dev-dependencies]` and report dependency graph errors.
pub fn resolve_dev_deps_checked(
  toml_path: String,
  project_dir: String
) -> result.Result(List(Dep), String):
  let lock_path = files.join(project_dir, "donna.lock")
  let locked = lock.read(lock_path)
  let toml_src = files.read(toml_path)
  let root_name = package_name(toml_src, files.basename(project_dir))
  let root_id = package_identity(toml_src, project_dir)
  let root_ids = initial_identity_stack(root_id)
  let #(runtime_deps, locked1) = parse_section(toml_src, project_dir, "dependencies", locked)
  case expand_deps_checked(runtime_deps, locked1, [], [], root_ids, root_name, []):
    ExpandErr(e) -> result.Error(e)
    ExpandOk(_, locked2, seen) ->
      let #(deps, locked3) = parse_section(toml_src, project_dir, "dev-dependencies", locked2)
      case expand_deps_checked(deps, locked3, seen, [], root_ids, root_name, []):
        ExpandErr(e) -> result.Error(e)
        ExpandOk(expanded, locked4, _) ->
          let _ = lock.write(lock_path, locked4)
          result.Ok(expanded)

/// Return Donna's dependency cache directory.
pub fn cache_dir() -> String:
  git_cache_dir()

fn expand_deps_checked(
  deps: List(Dep),
  locked: List(lock.LockedDep),
  seen: List(String),
  stack_names: List(String),
  stack_ids: List(String),
  root_name: String,
  acc: List(Dep)
) -> ExpandResult:
  case deps:
    [] -> ExpandOk(list.reverse(acc), locked, seen)
    [dep, ..rest] ->
      let name = dep_name(dep)
      case list.contains_str(stack_names, name):
        True ->
          ExpandErr(
            render_cycle_error(root_name, list.reverse([name, ..stack_names]))
          )
        False ->
          case list.contains_str(seen, name):
            True ->
              expand_deps_checked(
                rest,
                locked,
                seen,
                stack_names,
                stack_ids,
                root_name,
                acc
              )
            False ->
              let next_seen = [name, ..seen]
              let toml_path = files.join(dep_path(dep), "donna.toml")
              case files.exists(toml_path):
                False ->
                  expand_deps_checked(
                    rest,
                    locked,
                    next_seen,
                    stack_names,
                    stack_ids,
                    root_name,
                    [dep, ..acc]
                  )
                True ->
                  let child_src = files.read(toml_path)
                  let child_id = package_identity(child_src, dep_path(dep))
                  case is_identity_cycle(child_id, stack_ids):
                    True ->
                      ExpandErr(
                        render_cycle_error(
                          root_name,
                          list.reverse([name, ..stack_names])
                        )
                      )
                    False ->
                      let #(child_deps, locked1) = parse_section(
                        child_src,
                        dep_path(dep),
                        "dependencies",
                        locked
                      )
                      case expand_deps_checked(
                        child_deps,
                        locked1,
                        next_seen,
                        [name, ..stack_names],
                        push_identity(child_id, stack_ids),
                        root_name,
                        []
                      ):
                        ExpandErr(e) -> ExpandErr(e)
                        ExpandOk(expanded_children, locked2, seen2) ->
                          let acc2 = list.append(
                            [dep],
                            list.append(list.reverse(expanded_children), acc)
                          )
                          expand_deps_checked(
                            rest,
                            locked2,
                            seen2,
                            stack_names,
                            stack_ids,
                            root_name,
                            acc2
                          )

fn initial_identity_stack(identity: String) -> List(String):
  case string.is_empty(identity):
    True -> []
    False -> [identity]

fn push_identity(identity: String, ids: List(String)) -> List(String):
  case string.is_empty(identity):
    True -> ids
    False -> [identity, ..ids]

fn is_identity_cycle(identity: String, stack_ids: List(String)) -> Bool:
  case string.is_empty(identity):
    True -> False
    False -> list.contains_str(stack_ids, identity)

fn package_name(toml_src: String, fallback: String) -> String:
  let parsed = parsetoml.parse(toml_src)
  case parsetoml.is_err(parsed):
    True -> fallback
    False ->
      let toml = parsetoml.unwrap_table(parsed)
      case parsetoml.get_string(toml, "name"):
        parsetoml.Err(_) -> fallback
        parsetoml.Ok(name) -> name

fn package_identity(toml_src: String, project_dir: String) -> String:
  let parsed = parsetoml.parse(toml_src)
  case parsetoml.is_err(parsed):
    True -> "path:" <> project_dir
    False ->
      let toml = parsetoml.unwrap_table(parsed)
      case parsetoml.get_table(toml, "repository"):
        parsetoml.Err(_) -> "path:" <> project_dir
        parsetoml.Ok(repo) ->
          let kind = opt_string(repo, "type")
          let user = opt_string(repo, "user")
          let repo_name = opt_string(repo, "repo")
          case string.is_empty(kind) || string.is_empty(user) || string.is_empty(repo_name):
            True -> "path:" <> project_dir
            False -> kind <> ":" <> user <> "/" <> repo_name

fn render_cycle_error(root_name: String, cycle: List(String)) -> String:
  let path = colors.path(join_cycle([root_name, ..cycle]))
  let title = colors.error_header("error") <> ": cyclic dependency detected"
  let graph = colors.dim("  dependency graph: ") <> path
  let hint = colors.dim("  ") <> colors.orange("hint:") <> colors.dim(
    " remove one dependency edge or split shared code into another package"
  )
  string.join([title, graph, hint], "\n")

fn join_cycle(parts: List(String)) -> String:
  case parts:
    [] -> ""
    [one] -> one
    [one, ..rest] -> one <> " -> " <> join_cycle(rest)

fn parse_section(
  toml_src: String,
  project_dir: String,
  section: String,
  locked: List(lock.LockedDep)
) -> #(List(Dep), List(lock.LockedDep)):
  let parsed = parsetoml.parse(toml_src)
  case parsetoml.is_err(parsed):
    True -> #([], locked)
    False ->
      let toml = parsetoml.unwrap_table(parsed)
      case parsetoml.get_table(toml, section):
        parsetoml.Err(_) -> #([], locked)
        parsetoml.Ok(table) ->
          case table:
            parsetoml.TomlTable(pairs) ->
              collect_deps(pairs, project_dir, locked, [], locked)
            _ -> #([], locked)

fn collect_deps(
  pairs: List(#(String, parsetoml.TomlValue)),
  project_dir: String,
  locked: List(lock.LockedDep),
  dep_acc: List(Dep),
  lock_acc: List(lock.LockedDep)
) -> #(List(Dep), List(lock.LockedDep)):
  case pairs:
    [] -> #(list.reverse(dep_acc), lock_acc)
    [#(name, value), ..rest] ->
      case parsetoml.get_string(value, "path"):
        parsetoml.Ok(rel_path) ->
          let abs = files.join(project_dir, rel_path)
          collect_deps(
            rest,
            project_dir,
            locked,
            [Dep(name, abs), ..dep_acc],
            lock_acc
          )
        parsetoml.Err(_) ->
          case parsetoml.get_string(value, "git"):
            parsetoml.Err(_) ->
              collect_deps(rest, project_dir, locked, dep_acc, lock_acc)
            parsetoml.Ok(url) ->
              let #(dep, new_lock) = resolve_git_dep(name, url, value, locked)
              let new_lock_acc = lock.upsert(lock_acc, new_lock)
              collect_deps(
                rest,
                project_dir,
                locked,
                [dep, ..dep_acc],
                new_lock_acc
              )

fn resolve_git_dep(
  name: String,
  url: String,
  value: parsetoml.TomlValue,
  locked: List(lock.LockedDep)
) -> #(Dep, lock.LockedDep):
  let cache = git_cache_dir()
  let _ = shell.run("mkdir -p " <> cache)
  let dest = files.join(cache, name)
  let pinned_rev = lock.find_rev(locked, name)
  let cached_rev = lock.read_cached_rev(dest)
  case string.is_empty(pinned_rev):
    False ->
      case string.equal(pinned_rev, cached_rev):
        True ->
          #(Dep(name, dest), lock.LockedDep(name, url, pinned_rev))
        False ->
          let _ = shell.run("rm -rf " <> dest)
          let _ = shell.exec(
            "git",
            ["clone", "-c", "advice.detachedHead=false", url, dest]
          )
          let _ = shell.exec("git", ["-C", dest, "checkout", pinned_rev])
          let _ = lock.write_cached_rev(dest, pinned_rev)
          #(Dep(name, dest), lock.LockedDep(name, url, pinned_rev))
    True ->
      case files.is_dir(dest):
        True ->
          let ref = pick_ref(url, value)
          let _ = refresh_cached_dep(dest, url, ref)
          let rev = head_sha(dest)
          let _ = lock.write_cached_rev(dest, rev)
          #(Dep(name, dest), lock.LockedDep(name, url, rev))
        False ->
          let _ = logger.fetch(name, url)
          let _ = shell.flush()
          let ref = pick_ref(url, value)
          let _ = clone_at_ref(url, dest, ref)
          let rev = head_sha(dest)
          let _ = lock.write_cached_rev(dest, rev)
          #(Dep(name, dest), lock.LockedDep(name, url, rev))

fn pick_ref(url: String, value: parsetoml.TomlValue) -> String:
  let version = opt_string(value, "version")
  case string.is_empty(version):
    False -> resolve_version_range(url, version)
    True ->
      let tag = opt_string(value, "tag")
      case string.is_empty(tag):
        False -> tag
        True ->
          let branch = opt_string(value, "branch")
          case string.is_empty(branch):
            False -> branch
            True -> opt_string(value, "rev")

fn resolve_version_range(url: String, version_str: String) -> String:
  let cs = semver.parse_constraints(version_str)
  let output = shell.output("git", ["ls-remote", "--tags", "--sort=-v:refname", url])
  let lines = string.split(output, "\n")
  find_best_tag(lines, cs)

fn find_best_tag(lines: List(String), cs: List(semver.Constraint)) -> String:
  case lines:
    [] -> ""
    [line, ..rest] ->
      let tab = string.index_of(line, "\t")
      case tab == -1:
        True -> find_best_tag(rest, cs)
        False ->
          let ref = string.slice(line, tab + 1, string.length(line) - tab - 1)
          case string.ends_with(ref, "^{}"):
            True -> find_best_tag(rest, cs)
            False ->
              case string.starts_with(ref, "refs/tags/"):
                False -> find_best_tag(rest, cs)
                True ->
                  let tag = string.slice(ref, 10, string.length(ref) - 10)
                  case semver.parse(tag):
                    option.None -> find_best_tag(rest, cs)
                    option.Some(v) ->
                      case semver.satisfies(v, cs):
                        False -> find_best_tag(rest, cs)
                        True -> tag

fn clone_at_ref(url: String, dest: String, ref: String) -> Int:
  case string.is_empty(ref):
    True -> shell.exec("git", ["clone", "--depth", "1", url, dest])
    False ->
      let code = shell.exec("git", ["clone", "--depth", "1", "--branch", ref, url, dest])
      case code == 0:
        True -> code
        False ->
          let _ = shell.run("rm -rf " <> dest)
          let c = shell.exec("git", ["clone", url, dest])
          case c == 0:
            False -> c
            True -> shell.exec("git", ["-C", dest, "checkout", ref])

fn refresh_cached_dep(dest: String, url: String, ref: String) -> Int:
  case string.equal(origin_url(dest), url):
    False ->
      let _ = shell.run("rm -rf " <> dest)
      clone_at_ref(url, dest, ref)
    True ->
      let _ = shell.exec(
        "git",
        ["-C", dest, "fetch", "--tags", "--force", "--prune", "origin"]
      )
      case string.is_empty(ref):
        True -> shell.exec("git", ["-C", dest, "pull", "--ff-only"])
        False -> checkout_ref(dest, ref)

fn checkout_ref(dest: String, ref: String) -> Int:
  let code = shell.exec("git", ["-C", dest, "checkout", ref])
  case code == 0:
    True -> code
    False ->
      let _ = shell.exec("git", ["-C", dest, "fetch", "origin", ref])
      shell.exec("git", ["-C", dest, "checkout", ref])

fn origin_url(repo_path: String) -> String:
  string.trim(
    shell.output(
      "git",
      ["-C", repo_path, "config", "--get", "remote.origin.url"]
    )
  )

fn git_cache_dir() -> String:
  files.join(files.join(shell.getenv("HOME"), ".donna"), "packages")

fn head_sha(repo_path: String) -> String:
  string.trim(shell.output("git", ["-C", repo_path, "rev-parse", "HEAD"]))

fn opt_string(value: parsetoml.TomlValue, key: String) -> String:
  case parsetoml.get_string(value, key):
    parsetoml.Err(_) -> ""
    parsetoml.Ok(s) -> s
